diff --git a/node_modules/expo/scripts/autolinking.gradle b/node_modules/expo/scripts/autolinking.gradle
index 929b7f0..9087a12 100644
--- a/node_modules/expo/scripts/autolinking.gradle
+++ b/node_modules/expo/scripts/autolinking.gradle
@@ -1,9 +1,47 @@
 // Resolve `expo` > `expo-modules-autolinking` dependency chain
-def autolinkingPath = ["node", "--print", "require.resolve('expo-modules-autolinking/package.json', { paths: [require.resolve('expo/package.json')] })"]
+def awalletResolveNodeExecutable = {
+  def androidRoot = rootProject.projectDir
+  def fromEnv = System.getenv('NODE_BINARY')?.trim()
+  if (fromEnv) {
+    return fromEnv
+  }
+  def localProps = new File(androidRoot, 'local.properties')
+  if (localProps.exists()) {
+    def props = new Properties()
+    localProps.withInputStream { props.load(it) }
+    def explicit = props.getProperty('node.executable')?.trim()
+    if (explicit) {
+      return explicit
+    }
+    def nodejsDir = props.getProperty('nodejs.dir')?.trim()
+    if (nodejsDir) {
+      def candidate = new File(nodejsDir, 'bin/node')
+      if (candidate.canExecute()) {
+        return candidate.absolutePath
+      }
+    }
+  }
+  def home = System.getenv('HOME') ?: ''
+  for (path in [
+    '/opt/homebrew/bin/node',
+    '/usr/local/bin/node',
+    "${home}/.nvm/current/bin/node",
+    new File(androidRoot, 'tools/node').absolutePath,
+  ]) {
+    def file = new File(path)
+    if (file.canExecute()) {
+      return file.absolutePath
+    }
+  }
+  return new File(androidRoot, 'tools/node').absolutePath
+}
+
+def nodeExecutable = awalletResolveNodeExecutable()
+def autolinkingPath = [nodeExecutable, '--print', "require.resolve('expo-modules-autolinking/package.json', { paths: [require.resolve('expo/package.json')] })"]
 apply from: new File(
   providers.exec {
     workingDir(rootDir)
     commandLine(autolinkingPath)
   }.standardOutput.asText.get().trim(),
-  "../scripts/android/autolinking_implementation.gradle"
+  '../scripts/android/autolinking_implementation.gradle'
 )
