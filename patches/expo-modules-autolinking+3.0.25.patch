@@ -0,0 +1,42 @@
+package expo.modules.plugin
+
+import java.io.File
+import java.util.Properties
+
+/**
+ * Resolves the Node.js binary for Gradle subprocesses.
+ * Android Studio often lacks `node` on PATH; reads android/local.properties (node.executable).
+ */
+object NodeExecutable {
+  fun resolve(androidRoot: File): String {
+    System.getenv("NODE_BINARY")?.trim()?.takeIf { it.isNotEmpty() }?.let { return it }
+
+    val localProps = File(androidRoot, "local.properties")
+    if (localProps.exists()) {
+      val props = Properties()
+      localProps.inputStream().use { props.load(it) }
+      props.getProperty("node.executable")?.trim()?.takeIf { it.isNotEmpty() }?.let { return it }
+      props.getProperty("nodejs.dir")?.trim()?.takeIf { it.isNotEmpty() }?.let { dir ->
+        val node = File(dir, "bin/node")
+        if (node.canExecute()) {
+          return node.absolutePath
+        }
+      }
+    }
+
+    val home = System.getenv("HOME").orEmpty()
+    listOf(
+      "/opt/homebrew/bin/node",
+      "/usr/local/bin/node",
+      File(home, ".nvm/current/bin/node").absolutePath,
+      File(androidRoot, "tools/node").absolutePath,
+    ).forEach { path ->
+      val file = File(path)
+      if (file.canExecute()) {
+        return file.absolutePath
+      }
+    }
+
+    return "node"
+  }
+}
