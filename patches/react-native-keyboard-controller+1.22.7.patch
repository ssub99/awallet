--- a/node_modules/react-native-keyboard-controller/android/react-native-helpers.gradle
+++ b/node_modules/react-native-keyboard-controller/android/react-native-helpers.gradle
@@ -3,6 +3,41 @@ def safeAppExtGet(prop, fallback) {
   appProject?.ext?.has(prop) ? appProject.ext.get(prop) : fallback
 }
 
+def resolveNodeExecutable() {
+  def fromRoot = rootProject.ext.has('awalletNodeExecutable') ? rootProject.ext.get('awalletNodeExecutable') : null
+  if (fromRoot) {
+    return fromRoot
+  }
+  def fromEnv = System.getenv('NODE_BINARY')?.trim()
+  if (fromEnv) {
+    return fromEnv
+  }
+  def localPropsFile = new File(rootProject.projectDir, 'local.properties')
+  if (localPropsFile.exists()) {
+    def props = new Properties()
+    localPropsFile.withInputStream { props.load(it) }
+    def explicit = props.getProperty('node.executable')?.trim()
+    if (explicit) {
+      return explicit
+    }
+    def nodejsDir = props.getProperty('nodejs.dir')?.trim()
+    if (nodejsDir) {
+      def candidate = new File(nodejsDir, 'bin/node')
+      if (candidate.canExecute()) {
+        return candidate.absolutePath
+      }
+    }
+  }
+  def home = System.getenv('HOME') ?: ''
+  for (candidate in ['/opt/homebrew/bin/node', '/usr/local/bin/node', "${home}/.nvm/current/bin/node"]) {
+    def file = new File(candidate)
+    if (file.canExecute()) {
+      return file.absolutePath
+    }
+  }
+  return 'node'
+}
