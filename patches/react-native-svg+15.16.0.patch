+def resolveNodeExecutable() {
+  def fromRoot = safeExtGet("awalletNodeExecutable", null)
+  if (fromRoot) {
+    return fromRoot
+  }
+
+  def fromEnv = System.getenv("NODE_BINARY")?.trim()
+  if (fromEnv) {
+    return fromEnv
+  }
+
+  def localPropsFile = new File(rootProject.projectDir, "local.properties")
+  if (localPropsFile.exists()) {
+    def props = new Properties()
+    localPropsFile.withInputStream { props.load(it) }
+    def explicit = props.getProperty("node.executable")?.trim()
+    if (explicit) {
+      return explicit
+    }
+    def nodejsDir = props.getProperty("nodejs.dir")?.trim()
+    if (nodejsDir) {
+      def candidate = new File(nodejsDir, "bin/node")
+      if (candidate.canExecute()) {
+        return candidate.absolutePath
+      }
+    }
+  }
+
+  def home = System.getenv("HOME") ?: ""
+  def candidates = [
+    "/opt/homebrew/bin/node",
+    "/usr/local/bin/node",
+    "${home}/.nvm/current/bin/node",
+  ]
+  for (path in candidates) {
+    def file = new File(path)
+    if (file.canExecute()) {
+      return file.absolutePath
+    }
+  }
+  return "node"
+}
+
+def nodeExecutable = resolveNodeExecutable()
