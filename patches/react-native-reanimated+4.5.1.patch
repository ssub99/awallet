+fun resolveNodeExecutable(): String {
+    val rootNode = safeExtGet("awalletNodeExecutable", null) as String?
+    if (!rootNode.isNullOrBlank()) {
+        return rootNode
+    }
+
+    val fromEnv = System.getenv("NODE_BINARY")?.trim()
+    if (!fromEnv.isNullOrEmpty()) {
+        return fromEnv
+    }
+
+    val localProps = File(rootProject.projectDir, "local.properties")
+    if (localProps.exists()) {
+        val props = Properties()
+        localProps.inputStream().use { props.load(it) }
+        val nodeExecutable = props.getProperty("node.executable")?.trim()
+        if (!nodeExecutable.isNullOrEmpty()) {
+            return nodeExecutable
+        }
+        val nodejsDir = props.getProperty("nodejs.dir")?.trim()
+        if (!nodejsDir.isNullOrEmpty()) {
+            val candidate = File(nodejsDir, "bin/node")
+            if (candidate.canExecute()) {
+                return candidate.absolutePath
+            }
+        }
+    }
+
+    val home = System.getenv("HOME") ?: ""
+    val candidates = listOf(
+        "/opt/homebrew/bin/node",
+        "/usr/local/bin/node",
+        "$home/.nvm/current/bin/node",
+    )
+    for (path in candidates) {
+        if (File(path).canExecute()) {
+            return path
+        }
+    }
+    return "node"
+}
