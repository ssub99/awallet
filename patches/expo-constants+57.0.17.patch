 import org.apache.tools.ant.taskdefs.condition.Os
 
+def resolveNodeExecutableAndArgs() {
+  def fromEnv = System.getenv("NODE_BINARY")?.trim()
+  if (fromEnv) {
+    return [fromEnv]
+  }
+
+  def localProps = new File(rootProject.projectDir, "local.properties")
+  if (localProps.exists()) {
+    def props = new Properties()
+    localProps.withInputStream { props.load(it) }
+    def nodeExecutable = props.getProperty("node.executable")?.trim()
+    if (nodeExecutable) {
+      return [nodeExecutable]
+    }
+
+    def nodejsDir = props.getProperty("nodejs.dir")?.trim()
+    if (nodejsDir) {
+      def candidate = new File(nodejsDir, "bin/node")
+      if (candidate.canExecute()) {
+        return [candidate.absolutePath]
+      }
+    }
+  }
+
+  def home = System.getenv("HOME") ?: ""
+  def candidates = [
+    "/opt/homebrew/bin/node",
+    "/usr/local/bin/node",
+    "${home}/.nvm/current/bin/node",
+  ]
+  for (path in candidates) {
+    def file = new File(path)
+    if (file.canExecute()) {
+      return [file.absolutePath]
+    }
+  }
+
+  return ["node"]
+}
+
+def resolvedNodeExecutableAndArgs = resolveNodeExecutableAndArgs()
 
