+package expo.modules.plugin
+
+import java.io.File
+import java.util.Properties
+
+/**
+ * Resolve an absolute node binary path.
+ * Android Studio Gradle sync often has no `node` on PATH.
+ */
+object NodeBinary {
+  fun resolve(projectRoot: File = File(System.getProperty("user.dir") ?: ".")): String {
+    System.getenv("NODE_BINARY")?.trim()?.takeIf { it.isNotEmpty() && File(it).canExecute() }?.let {
+      return it
+    }
+
+    val localProperties = File(projectRoot, "local.properties")
+    if (localProperties.exists()) {
+      val props = Properties()
+      localProperties.inputStream().use { props.load(it) }
+      props.getProperty("node.executable")?.trim()?.takeIf { it.isNotEmpty() && File(it).canExecute() }?.let {
+        return it
+      }
+      props.getProperty("nodejs.dir")?.trim()?.let { dir ->
+        val candidate = File(dir, "bin/node")
+        if (candidate.canExecute()) {
+          return candidate.absolutePath
+        }
+      }
+    }
+
+    val home = System.getenv("HOME") ?: ""
+    val candidates = listOf(
+      "/opt/homebrew/bin/node",
+      "/usr/local/bin/node",
+      "$home/.nvm/current/bin/node",
+      File(projectRoot, "tools/node").absolutePath,
+    )
+    for (path in candidates) {
+      if (File(path).canExecute()) {
+        return path
+      }
+    }
+    return "node"
+  }
+}
