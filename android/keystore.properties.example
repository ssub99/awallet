# Play Store / Galaxy Store release 서명 (이 파일을 keystore.properties 로 복사)
# keystore.properties 와 keystore/ 는 gitignore — 절대 커밋하지 마세요.
#
# 최초 1회: 프로젝트 루트에서
#   bash scripts/setup-android-release-signing.sh
#
# storeFile 은 android/ 기준 상대 경로

storeFile=keystore/awallet-upload.keystore
storePassword=YOUR_STORE_PASSWORD
keyAlias=awallet-upload
keyPassword=YOUR_KEY_PASSWORD
