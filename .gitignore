# Google Services (contains API keys)
# iOS: ios/awallet/GoogleService-Info.plist (tracked). Android: android-firebase/ 원본 + prebuild가 android/app/으로 복사.
GoogleService-Info.plist
ios/GoogleService-Info.plist
!ios/awallet/GoogleService-Info.plist
google-services.json
android/app/google-services.json
!android-firebase/google-services.json
