# TypeScript Guidelines for AWallet

## 🎯 TYPE SAFETY PRINCIPLES

### Type Inference vs Explicit Types:
```typescript
// Let TypeScript infer when obvious ✅
const count = 5; // inferred as number
const items = ['a', 'b', 'c']; // inferred as string[]

// Be explicit for function returns and props ✅
function calculateTotal(items: CartItem[]): number {
  return items.reduce((sum, item) => sum + item.price, 0);
}

// Always type component props ✅
interface ButtonProps {
  title: string;
  onPress: () => void;
  disabled?: boolean;
}

export function Button({ title, onPress, disabled = false }: ButtonProps) {
  // implementation
}
```

## 🚫 FORBIDDEN PATTERNS

### Never Use:
```typescript
// ❌ NEVER - any bypasses type safety
const data: any = fetchData();

// ✅ USE - unknown with type guards
const data: unknown = fetchData();
if (isValidData(data)) {
  // data is now properly typed
}

// ❌ NEVER - non-null assertion without reason
const value = maybeUndefined!;

// ✅ USE - proper null checking
const value = maybeUndefined ?? defaultValue;
if (maybeUndefined !== undefined) {
  // safely use maybeUndefined
}

// ❌ NEVER - as any casting
const result = (something as any).property;

// ✅ USE - proper type guards
function isObjectWithProperty(obj: unknown): obj is { property: string } {
  return typeof obj === 'object' && obj !== null && 'property' in obj;
}
```

## ✅ REQUIRED PATTERNS

### Strict Null Checks:
```typescript
// Handle undefined/null explicitly ✅
interface User {
  name: string;
  email?: string; // optional property
}

function getUserEmail(user: User): string {
  return user.email ?? 'No email provided';
}

// Use optional chaining ✅
const userEmail = user?.profile?.email;

// Nullish coalescing for defaults ✅
const displayName = user.name ?? 'Anonymous';
```

### Discriminated Unions:
```typescript
// Excellent for state management ✅
type LoadingState<T> =
  | { status: 'idle' }
  | { status: 'loading' }
  | { status: 'success'; data: T }
  | { status: 'error'; error: Error };

function renderData<T>(state: LoadingState<T>) {
  switch (state.status) {
    case 'idle':
      return null;
    case 'loading':
      return <LoadingSpinner />;
    case 'success':
      return <DataView data={state.data} />;
    case 'error':
      return <ErrorMessage error={state.error} />;
  }
}
```

### Generic Constraints:
```typescript
// Constrain generics appropriately ✅
interface HasId {
  id: string;
}

function findById<T extends HasId>(items: T[], id: string): T | undefined {
  return items.find(item => item.id === id);
}

// React component with generic props ✅
interface ListProps<T> {
  items: T[];
  renderItem: (item: T) => React.ReactNode;
  keyExtractor: (item: T) => string;
}

function List<T>({ items, renderItem, keyExtractor }: ListProps<T>) {
  return (
    <View>
      {items.map(item => (
        <View key={keyExtractor(item)}>
          {renderItem(item)}
        </View>
      ))}
    </View>
  );
}
```

