## 📚 IMPORT/EXPORT PATTERNS

### Prefer Named Exports:
```typescript
// Good ✅ - explicit and tree-shakeable
export interface UserData {
  id: string;
  name: string;
}

export function formatUser(user: UserData): string {
  return `${user.name} (${user.id})`;
}

// Acceptable for components ✅
export default function UserProfile() {
  // ...
}

// Avoid ❌ - harder to refactor
export default {
  UserData,
  formatUser,
};
```

### Use Barrel Exports Carefully:
```typescript
// components/index.ts
// Only re-export if it adds value ✅
export { ThemedText } from './themed-text';
export { ThemedView } from './themed-view';
export type { ThemedTextProps } from './themed-text';
export type { ThemedViewProps } from './themed-view';
```

## 🎯 ASYNC/AWAIT TYPING

### Promise Handling:
```typescript
// Type async functions explicitly ✅
async function fetchUser(id: string): Promise<User> {
  const response = await fetch(`/api/users/${id}`);
  if (!response.ok) {
    throw new Error(`Failed to fetch user: ${response.statusText}`);
  }
  return response.json();
}

// Handle errors with proper types ✅
async function safelyFetchUser(id: string): Promise<User | null> {
  try {
    return await fetchUser(id);
  } catch (error) {
    if (error instanceof Error) {
      console.error('Fetch error:', error.message);
    }
    return null;
  }
}
```

## 🚨 ERROR HANDLING TYPES

### Typed Errors:
```typescript
// Custom error types ✅
class ValidationError extends Error {
  constructor(
    message: string,
    public field: string,
    public value: unknown
  ) {
    super(message);
    this.name = 'ValidationError';
  }
}

class NetworkError extends Error {
  constructor(
    message: string,
    public statusCode: number,
    public endpoint: string
  ) {
    super(message);
    this.name = 'NetworkError';
  }
}

// Type-safe error handling ✅
function handleError(error: unknown): string {
  if (error instanceof ValidationError) {
    return `Invalid ${error.field}: ${error.message}`;
  }
  if (error instanceof NetworkError) {
    return `Network error (${error.statusCode}): ${error.message}`;
  }
  if (error instanceof Error) {
    return error.message;
  }
  return 'An unknown error occurred';
}
```

## 📖 DOCUMENTATION WITH TYPES

### JSDoc with TypeScript:
```typescript
/**
 * Calculates the total price of items in the cart
 * 
 * @param items - Array of cart items with price and quantity
 * @param discountPercent - Optional discount to apply (0-100)
 * @returns The total price after applying discount
 * 
 * @example
 * ```ts
 * const total = calculateCartTotal([
 *   { price: 10, quantity: 2 },
 *   { price: 15, quantity: 1 }
 * ], 10);
 * // Returns: 31.5 (35 with 10% discount)
 * ```
 */
export function calculateCartTotal(
  items: Array<{ price: number; quantity: number }>,
  discountPercent: number = 0
): number {
  const subtotal = items.reduce((sum, item) => sum + item.price * item.quantity, 0);
  return subtotal * (1 - discountPercent / 100);
}
```

