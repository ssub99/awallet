# Expo Router Guidelines for AWallet

## 🗺️ FILE-BASED ROUTING

### Directory Structure (DO NOT CHANGE):
```
app/
  _layout.tsx           → Root layout
  (tabs)/               → Tab group
    _layout.tsx         → Tab navigator layout
    explore.tsx         → /explore route
  modal.tsx             → Modal route
```

### Route Naming Conventions:
```
app/index.tsx          → / (home route)
app/about.tsx          → /about
app/users/[id].tsx     → /users/:id (dynamic route)
app/users/index.tsx    → /users
app/(group)/page.tsx   → /page (group doesn't affect URL)
app/_hidden.tsx        → Not accessible as route
```

## 🚫 ROUTING - NEVER DO

### Don't Use React Navigation Directly:
```typescript
// ❌ NEVER - Don't import from @react-navigation/native
import { useNavigation } from '@react-navigation/native';

// ✅ USE - Expo Router hooks
import { useRouter, useLocalSearchParams } from 'expo-router';
```

### Don't Hardcode URLs:
```typescript
// ❌ WRONG - Hardcoded path
router.push('/users/123');

// ✅ CORRECT - Type-safe with typed routes
router.push({
  pathname: '/users/[id]',
  params: { id: '123' }
});

// ✅ BEST - Use Link component for navigation
import { Link } from 'expo-router';

<Link href={{ pathname: '/users/[id]', params: { id: user.id } }}>
  View Profile
</Link>
```

## ✅ ROUTING - ALWAYS DO

### Use Typed Routes:
```typescript
// ✅ Typed routes are enabled in app.json
import { router } from 'expo-router';

// TypeScript will autocomplete and validate routes
router.push('/explore');
router.push('/modal');
```

### Navigation Patterns:
```typescript
import { useRouter, useLocalSearchParams, Stack } from 'expo-router';

// ✅ Basic navigation
export default function HomePage() {
  const router = useRouter();
  
  return (
    <Pressable onPress={() => router.push('/explore')}>
      <Text>Go to Explore</Text>
    </Pressable>
  );
}

// ✅ Dynamic routes with params
export default function UserPage() {
  const { id } = useLocalSearchParams<{ id: string }>();
  
  return <Text>User ID: {id}</Text>;
}

// ✅ Programmatic navigation with params
function navigateToUser(userId: string) {
  router.push({
    pathname: '/users/[id]',
    params: { id: userId, tab: 'profile' }
  });
}
```

### Layout Components:
```typescript
// ✅ Root layout pattern (app/_layout.tsx)
import { Stack } from 'expo-router';
import { useThemeColor } from '@/hooks/use-theme-color';

export default function RootLayout() {
  const backgroundColor = useThemeColor({}, 'background');
  
  return (
    <Stack
      screenOptions={{
        headerStyle: { backgroundColor },
        headerTintColor: useThemeColor({}, 'text'),
      }}
    >
      <Stack.Screen name="(tabs)" options={{ headerShown: false }} />
      <Stack.Screen name="modal" options={{ presentation: 'modal' }} />
    </Stack>
  );
}

// ✅ Tab layout pattern (app/(tabs)/_layout.tsx)
import { Tabs } from 'expo-router';
import { useThemeColor } from '@/hooks/use-theme-color';

export default function TabLayout() {
  const tabBarActiveTintColor = useThemeColor({}, 'tint');
  
  return (
    <Tabs
      screenOptions={{
        tabBarActiveTintColor,
        headerShown: false,
      }}
    >
      <Tabs.Screen
        name="index"
        options={{
          title: 'Home',
          tabBarIcon: ({ color }) => <TabBarIcon name="home" color={color} />,
        }}
      />
      <Tabs.Screen
        name="explore"
        options={{
          title: 'Explore',
          tabBarIcon: ({ color }) => <TabBarIcon name="code" color={color} />,
        }}
      />
    </Tabs>
  );
}
```

## 🔗 NAVIGATION COMPONENTS

### Link Component (Preferred):
```typescript
import { Link } from 'expo-router';

// ✅ Simple link
<Link href="/about">About</Link>

// ✅ Link with params
<Link
  href={{
    pathname: '/users/[id]',
    params: { id: user.id, name: user.name }
  }}
>
  {user.name}
</Link>

// ✅ Link with custom child
<Link href="/profile" asChild>
  <Pressable style={styles.button}>
    <Text>View Profile</Text>
  </Pressable>
</Link>

// ✅ Replace instead of push
<Link href="/login" replace>
  Go to Login
</Link>
```

### Router Hooks:
```typescript
import { useRouter, usePathname, useGlobalSearchParams } from 'expo-router';

export function NavigationExample() {
  const router = useRouter();
  const pathname = usePathname(); // Current route path
  const params = useGlobalSearchParams(); // All search params
  
  // Navigation methods
  router.push('/page');      // Push new route
  router.replace('/page');   // Replace current route
  router.back();             // Go back
  router.dismiss();          // Dismiss modal
  router.canGoBack();        // Check if can go back
  
  return null;
}
```

## 📱 SCREEN OPTIONS

### Configuring Screens:
```typescript
// ✅ In the page file
import { Stack } from 'expo-router';

export default function ProfilePage() {
  return (
    <>
      <Stack.Screen
        options={{
          title: 'User Profile',
          headerRight: () => (
            <Pressable onPress={handleEdit}>
              <Text>Edit</Text>
            </Pressable>
          ),
        }}
      />
      <View>
        {/* Page content */}
      </View>
    </>
  );
}

// ✅ Dynamic title based on data
export default function UserPage() {
  const { id } = useLocalSearchParams<{ id: string }>();
  const user = useUser(id);
  
  return (
    <>
      <Stack.Screen
        options={{
          title: user?.name ?? 'Loading...',
        }}
      />
      <View>{/* Content */}</View>
    </>
  );
}
```

## 🎭 MODAL PRESENTATION

### Modal Routes:
```typescript
// ✅ Present as modal (in _layout.tsx)
<Stack>
  <Stack.Screen
    name="modal"
    options={{
      presentation: 'modal',
      title: 'Modal Title',
    }}
  />
</Stack>

// ✅ In modal page (app/modal.tsx)
import { useRouter } from 'expo-router';

export default function ModalScreen() {
  const router = useRouter();
  
  return (
    <View>
      <Text>This is a modal</Text>
      <Pressable onPress={() => router.dismiss()}>
        <Text>Close</Text>
      </Pressable>
    </View>
  );
}
```

## 🔐 ROUTE GUARDS & PROTECTION

### Authentication Guards:
```typescript
// ✅ Protect routes with guards
import { Redirect } from 'expo-router';
import { useAuth } from '@/hooks/use-auth';

export default function ProtectedPage() {
  const { user, loading } = useAuth();
  
  if (loading) {
    return <LoadingSpinner />;
  }
  
  if (!user) {
    return <Redirect href="/login" />;
  }
  
  return <View>{/* Protected content */}</View>;
}
```

## 📊 SEARCH PARAMS

### Query Parameters:
```typescript
import { useLocalSearchParams, useGlobalSearchParams } from 'expo-router';

// ✅ Local search params (for current route)
export default function SearchPage() {
  const { query, filter } = useLocalSearchParams<{
    query?: string;
    filter?: string;
  }>();
  
  return (
    <View>
      <Text>Searching for: {query}</Text>
      <Text>Filter: {filter}</Text>
    </View>
  );
}

// ✅ Navigate with search params
router.push({
  pathname: '/search',
  params: { query: 'react', filter: 'recent' }
});
// Results in: /search?query=react&filter=recent
```

## 🎨 TAB BAR CUSTOMIZATION

### Custom Tab Bar:
```typescript
// ✅ Custom tab bar with theme
import { Tabs } from 'expo-router';
import { HapticTab } from '@/components/haptic-tab';

export default function TabLayout() {
  return (
    <Tabs
      screenOptions={{
        tabBarActiveTintColor: useThemeColor({}, 'tint'),
        headerShown: false,
        tabBarButton: HapticTab, // Custom haptic feedback
        tabBarStyle: {
          backgroundColor: useThemeColor({}, 'background'),
        },
      }}
    >
      <Tabs.Screen
        name="index"
        options={{
          title: 'Home',
          tabBarIcon: ({ color, focused }) => (
            <TabBarIcon
              name={focused ? 'home' : 'home-outline'}
              color={color}
            />
          ),
        }}
      />
    </Tabs>
  );
}
```

## 🚨 ERROR HANDLING

### Not Found Routes:
```typescript
// ✅ Create app/+not-found.tsx
import { Link, Stack } from 'expo-router';

export default function NotFoundScreen() {
  return (
    <>
      <Stack.Screen options={{ title: 'Oops! Not Found' }} />
      <View>
        <Text>This screen doesn't exist.</Text>
        <Link href="/">Go to home screen</Link>
      </View>
    </>
  );
}
```

## 📚 DEEP LINKING

### URL Scheme Configuration:
```typescript
// ✅ Already configured in app.json
{
  "scheme": "awallet"
}

// Links will work as:
// awallet://
// awallet://users/123
// awallet://modal

// ✅ Handle deep links
import { useEffect } from 'react';
import * as Linking from 'expo-linking';

export function useDeepLinking() {
  useEffect(() => {
    const handleUrl = ({ url }: { url: string }) => {
      const { path, queryParams } = Linking.parse(url);
      // Handle the deep link
    };
    
    const subscription = Linking.addEventListener('url', handleUrl);
    
    return () => subscription.remove();
  }, []);
}
```

## 🎯 BEST PRACTICES

### Navigation Structure:
1. **Use file-based routing** - Let Expo Router handle the routing
2. **Type-safe navigation** - Leverage typed routes
3. **Prefer Link over router.push** - Better for SEO and accessibility
4. **Use layouts effectively** - Share navigation UI across routes
5. **Handle loading states** - Show feedback during navigation
6. **Implement not-found** - Create +not-found.tsx for 404 handling

### Performance:
```typescript
// ✅ Lazy load heavy screens
const HeavyScreen = React.lazy(() => import('./heavy-screen'));

// ✅ Prefetch routes for better UX
import { useFocusEffect } from 'expo-router';

useFocusEffect(
  useCallback(() => {
    router.prefetch('/next-screen');
  }, [])
);
```

---

**Remember**: Expo Router is file-based. The file structure IS your route structure.
