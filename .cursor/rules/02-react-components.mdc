# React Component Guidelines for AWallet

## 🎯 COMPONENT ARCHITECTURE

### Functional Components Only:
```typescript
// ✅ CORRECT - Functional component with TypeScript
import { View, Text } from 'react-native';

interface UserCardProps {
  name: string;
  email: string;
  onPress?: () => void;
}

export function UserCard({ name, email, onPress }: UserCardProps) {
  return (
    <View>
      <Text>{name}</Text>
      <Text>{email}</Text>
    </View>
  );
}

// ❌ NEVER - Class components are forbidden
class UserCard extends React.Component {
  render() {
    // Don't do this!
  }
}
```

## 🪝 HOOKS USAGE

### Rules of Hooks (STRICTLY ENFORCED):
```typescript
// ✅ CORRECT - Hooks at top level
function MyComponent() {
  const [count, setCount] = useState(0);
  const theme = useThemeColor({}, 'background');
  
  useEffect(() => {
    // effect logic
  }, []);
  
  return <View />;
}

// ❌ WRONG - Conditional hooks
function MyComponent({ showExtra }) {
  const [count, setCount] = useState(0);
  
  if (showExtra) {
    const extra = useState(0); // NEVER DO THIS!
  }
  
  return <View />;
}

// ❌ WRONG - Hooks in loops
function MyComponent({ items }) {
  return items.map(item => {
    const [state] = useState(item); // NEVER DO THIS!
    return <View key={item.id} />;
  });
}
```

### useState Best Practices:
```typescript
// ✅ Functional updates for state based on previous state
const [count, setCount] = useState(0);
setCount(prev => prev + 1);

// ✅ Complex state with proper typing
interface FormState {
  username: string;
  email: string;
  isValid: boolean;
}

const [form, setForm] = useState<FormState>({
  username: '',
  email: '',
  isValid: false,
});

// Update immutably
setForm(prev => ({ ...prev, username: 'newUsername' }));

// ❌ Direct mutation
form.username = 'newUsername'; // NEVER!
setForm(form); // NEVER!
```

### useEffect Best Practices:
```typescript
// ✅ CORRECT - All dependencies listed
useEffect(() => {
  fetchData(userId);
}, [userId]);

// ✅ Cleanup functions
useEffect(() => {
  const subscription = subscribeToData();
  
  return () => {
    subscription.unsubscribe();
  };
}, []);

// ❌ WRONG - Missing dependencies
useEffect(() => {
  fetchData(userId); // userId not in deps!
}, []);

// ❌ WRONG - Async effect directly
useEffect(async () => { // NEVER!
  await fetchData();
}, []);

// ✅ CORRECT - Async in effect
useEffect(() => {
  const fetchDataAsync = async () => {
    const data = await fetchData();
    setData(data);
  };
  
  fetchDataAsync();
}, []);
```

### useMemo & useCallback:
```typescript
// ✅ useMemo for expensive calculations
const sortedItems = useMemo(() => {
  return items.sort((a, b) => a.price - b.price);
}, [items]);

// ✅ useCallback for functions passed to children
const handlePress = useCallback(() => {
  console.log('Pressed!', userId);
}, [userId]);

// ❌ Overusing memoization (premature optimization)
const simpleValue = useMemo(() => x + y, [x, y]); // Unnecessary!
```

### Custom Hooks Pattern:
```typescript
// ✅ Custom hook following naming convention
import { useState, useEffect } from 'react';

interface UseApiOptions<T> {
  url: string;
  initialData?: T;
}

interface UseApiResult<T> {
  data: T | null;
  loading: boolean;
  error: Error | null;
  refetch: () => void;
}

export function useApi<T>({ url, initialData = null }: UseApiOptions<T>): UseApiResult<T> {
  const [data, setData] = useState<T | null>(initialData);
  const [loading, setLoading] = useState(false);
  const [error, setError] = useState<Error | null>(null);

  const fetchData = useCallback(async () => {
    setLoading(true);
    setError(null);
    
    try {
      const response = await fetch(url);
      const json = await response.json();
      setData(json);
    } catch (err) {
      setError(err instanceof Error ? err : new Error('Unknown error'));
    } finally {
      setLoading(false);
    }
  }, [url]);

  useEffect(() => {
    fetchData();
  }, [fetchData]);

  return { data, loading, error, refetch: fetchData };
}
```

## 🎨 COMPONENT PATTERNS

### Composition Over Inheritance:
```typescript
// ✅ CORRECT - Composition with children
interface CardProps {
  children: React.ReactNode;
  variant?: 'default' | 'elevated';
}

export function Card({ children, variant = 'default' }: CardProps) {
  return (
    <View style={[styles.card, variant === 'elevated' && styles.elevated]}>
      {children}
    </View>
  );
}

// Usage
<Card>
  <Text>Content here</Text>
</Card>
```

### Render Props Pattern:
```typescript
// ✅ Useful for sharing behavior
interface DataProviderProps<T> {
  data: T[];
  children: (items: T[], loading: boolean) => React.ReactNode;
}

export function DataProvider<T>({ data, children }: DataProviderProps<T>) {
  const [loading, setLoading] = useState(true);
  
  useEffect(() => {
    setTimeout(() => setLoading(false), 1000);
  }, []);
  
  return <>{children(data, loading)}</>;
}

// Usage
<DataProvider data={items}>
  {(items, loading) => loading ? <Spinner /> : <List items={items} />}
</DataProvider>
```

### Compound Components:
```typescript
// ✅ Great for complex, related components
interface TabsContextType {
  activeTab: string;
  setActiveTab: (tab: string) => void;
}

const TabsContext = createContext<TabsContextType | undefined>(undefined);

export function Tabs({ children }: { children: React.ReactNode }) {
  const [activeTab, setActiveTab] = useState('tab1');
  
  return (
    <TabsContext.Provider value={{ activeTab, setActiveTab }}>
      <View>{children}</View>
    </TabsContext.Provider>
  );
}

Tabs.Tab = function Tab({ id, children }: { id: string; children: React.ReactNode }) {
  const context = useContext(TabsContext);
  if (!context) throw new Error('Tab must be used within Tabs');
  
  const isActive = context.activeTab === id;
  
  return (
    <Pressable onPress={() => context.setActiveTab(id)}>
      <Text style={isActive && styles.activeTab}>{children}</Text>
    </Pressable>
  );
};

// Usage
<Tabs>
  <Tabs.Tab id="tab1">First Tab</Tabs.Tab>
  <Tabs.Tab id="tab2">Second Tab</Tabs.Tab>
</Tabs>
```

## 🎭 COMPONENT OPTIMIZATION

### React.memo:
```typescript
// ✅ Memoize expensive components
interface ExpensiveComponentProps {
  data: ComplexData;
  onAction: () => void;
}

export const ExpensiveComponent = React.memo<ExpensiveComponentProps>(
  ({ data, onAction }) => {
    // Expensive rendering logic
    return <View>{/* ... */}</View>;
  }
);

// ✅ Custom comparison function
export const UserItem = React.memo<UserItemProps>(
  ({ user }) => <Text>{user.name}</Text>,
  (prevProps, nextProps) => prevProps.user.id === nextProps.user.id
);
```

### Avoid Inline Objects/Arrays:
```typescript
// ❌ WRONG - Creates new object on every render
<Component style={{ padding: 10 }} />

// ✅ CORRECT - Define outside or use StyleSheet
const styles = StyleSheet.create({
  container: { padding: 10 }
});
<Component style={styles.container} />

// ❌ WRONG - Creates new array on every render
<List data={[item1, item2]} />

// ✅ CORRECT - Define as constant or state
const items = useMemo(() => [item1, item2], [item1, item2]);
<List data={items} />
```

## ♿ ACCESSIBILITY (REQUIRED)

### Always Add Accessibility Props:
```typescript
// ✅ REQUIRED for all interactive elements
<Pressable
  onPress={handlePress}
  accessibilityRole="button"
  accessibilityLabel="Submit form"
  accessibilityHint="Double tap to submit the registration form"
  accessibilityState={{ disabled: isDisabled }}
>
  <Text>Submit</Text>
</Pressable>

// ✅ For images
<Image
  source={avatar}
  accessibilityLabel={`${user.name}'s profile picture`}
  accessibilityRole="image"
/>

// ✅ For text inputs
<TextInput
  placeholder="Email"
  accessibilityLabel="Email address"
  accessibilityHint="Enter your email address"
/>
```

## 🎨 STYLING PATTERNS

### Use Theme System:
```typescript
import { useThemeColor } from '@/hooks/use-theme-color';

// ✅ CORRECT - Use theme colors
export function ThemedComponent() {
  const backgroundColor = useThemeColor({}, 'background');
  const textColor = useThemeColor({}, 'text');
  
  return (
    <View style={[styles.container, { backgroundColor }]}>
      <Text style={[styles.text, { color: textColor }]}>
        Content
      </Text>
    </View>
  );
}

// ❌ WRONG - Hardcoded colors
export function BadComponent() {
  return (
    <View style={{ backgroundColor: '#FFFFFF' }}>
      <Text style={{ color: '#000000' }}>Content</Text>
    </View>
  );
}
```

### StyleSheet Best Practices:
```typescript
// ✅ Define styles at bottom of file
const styles = StyleSheet.create({
  container: {
    flex: 1,
    padding: 16,
  },
  title: {
    fontSize: 24,
    fontWeight: 'bold',
    marginBottom: 8,
  },
});

// ✅ Conditional styles
