/**
 * Expense Edit Screen
 * 
 * Screen for editing existing expense records.
 */

import { TopNavigation } from '@/components/navigation/top-navigation';
import { Button } from '@/components/ui/button';
import { CalendarDaySelect } from '@/components/ui/calendar-day-select';
import { Checkbox } from '@/components/ui/checkbox';
import { Icon } from '@/components/ui/icon';
import { Input } from '@/components/ui/input';
import { ModalBottomsheet } from '@/components/ui/modal-bottomsheet';
import { ModalPopup } from '@/components/ui/modal-popup';
import { Radio } from '@/components/ui/radio';
import { Switch } from '@/components/ui/switch';
import { Toast } from '@/components/ui/toast';
import { Colors, Typography } from '@/constants/theme';
import { useColorScheme } from '@/hooks/use-color-scheme';
import AsyncStorage from '@react-native-async-storage/async-storage';
import { Picker } from '@react-native-picker/picker';
import { useFocusEffect, useLocalSearchParams, useRouter } from 'expo-router';
import { useCallback, useEffect, useRef, useState } from 'react';
import { Dimensions, Keyboard, Modal, Platform, Pressable, ScrollView, StatusBar, StyleSheet, Text, View } from 'react-native';
import { SafeAreaView, useSafeAreaInsets } from 'react-native-safe-area-context';

/**
 * 해당 월의 실제 일자 계산 (월말 처리)
 * 예: 2월 31일 → 2월 28일 (마지막 날)
 */
function getActualDayForMonth(year: number, month: number, desiredDay: number): number {
  const lastDayOfMonth = new Date(year, month, 0).getDate();
  return Math.min(desiredDay, lastDayOfMonth);
}

/**
 * 요일 계산 함수
 */
function getDayOfWeekLabel(year: number, month: number, day: number): string {
  const weekdays = ['일', '월', '화', '수', '목', '금', '토'];
  const date = new Date(year, month - 1, day);
  return weekdays[date.getDay()];
}

interface ExpenseRecord {
  type: 'expense';
  amount: number;
  category: string;
  memo: string;
  date: string;
  timestamp: number;
  isRecurring?: boolean;
  weekendOption?: 'weekend' | 'friday' | 'monday';
  recurringId?: string;      // 정기 지출 원본 기록의 ID
  isAutoGenerated?: boolean; // 정기 지출로 자동 생성된 기록인지 표시
}

export default function ExpenseEditScreen() {
  const colorScheme = useColorScheme();
  const colors = Colors[colorScheme ?? 'light'] as typeof Colors.light;
  const router = useRouter();
  const insets = useSafeAreaInsets();

  const params = useLocalSearchParams<{ 
    recordData?: string;
    dateKey?: string;
    recordIndex?: string;
  }>();
  const scrollViewRef = useRef<ScrollView>(null);
  
  // Parse record data from params
  const recordData: ExpenseRecord = params.recordData ? JSON.parse(params.recordData) : null;
  const dateKey = params.dateKey || '';
  const recordIndex = parseInt(params.recordIndex || '0');
  
  // 화면 진입 로그 및 최초 생성년월 찾기
  useEffect(() => {
    console.log('📍 [위치] 소비내역 수정 화면');
    
    
    
    // 정기 지출 기록인 경우 최초 생성년월 찾기
    const findOriginalYearMonth = async () => {
      if (!isEditingRecurring && !isEditingAutoGenerated) return;
      
      try {
        const storedData = await AsyncStorage.getItem('calendarData');
        const calendarData = storedData ? JSON.parse(storedData) : {};
        
        const recurringId = recordData?.recurringId;
        if (!recurringId) return;
        
        // 모든 관련 기록 찾기
        let parentRecord: any = null;
        
        Object.keys(calendarData).forEach(key => {
          if (calendarData[key].records) {
            calendarData[key].records.forEach((r: any) => {
              if (r.recurringId === recurringId && r.isAutoGenerated === false) {
                parentRecord = { ...r, dateKey: key };
              }
            });
          }
        });
        
        if (parentRecord) {
          const [year, month] = parentRecord.dateKey.split('-');
          setOriginalYearMonth(`${year}/${month}`);
          console.log('📅 [최초생성년월] 찾음:', `${year}/${month}`);
        }
      } catch (error) {
        console.error('❌ [에러] 최초 생성년월 찾기 실패:', error);
      }
    };
    
    findOriginalYearMonth();
    
  }, []);
  
  // 카테고리 선택 화면에서 돌아올 때 선택된 카테고리 확인
  useFocusEffect(
    useCallback(() => {
      const loadSelectedCategory = async () => {
        const selectedCategory = await AsyncStorage.getItem('selectedCategory');
        console.log('🔍 [카테고리] AsyncStorage에서 로드:', selectedCategory);
        if (selectedCategory) {
          console.log('✅ [카테고리] 카테고리 변경:', category, '→', selectedCategory);
          setCategory(selectedCategory);
          // 사용 후 삭제
          await AsyncStorage.removeItem('selectedCategory');
          console.log('🗑️ [카테고리] AsyncStorage에서 삭제 완료');
        }
      };
      
      loadSelectedCategory();
    }, [])
  );
  
  // Form state
  const [category, setCategory] = useState<string>(recordData?.category || '');
  const [amount, setAmount] = useState<string>(
    recordData?.amount ? recordData.amount.toLocaleString() : ''
  );
  const [date, setDate] = useState<string>(
    recordData?.date ? recordData.date.replace(/-/g, '.') : ''
  );
  const [memo, setMemo] = useState<string>(recordData?.memo || '');
  
  // 자동생성된 기록인지 확인
  const isEditingAutoGenerated = recordData?.isAutoGenerated === true;
  
  // 정기 지출 기록인지 확인 (부모/자식 모두 포함)
  const isEditingRecurring = recordData?.isRecurring === true;
  
  
  // 최초 생성년월 찾기 (정기 지출 기록인 경우)
  const [originalYearMonth, setOriginalYearMonth] = useState<string>('');
  
  
  // 자동생성 기록도 부모의 정기 지출 설정을 표시 (단, 수정 불가)
  const [isRecurring, setIsRecurring] = useState<boolean>(recordData?.isRecurring || false);
  const [weekendOption, setWeekendOption] = useState<'weekend' | 'friday' | 'monday'>(recordData?.weekendOption || 'weekend');
  const [showDatePicker, setShowDatePicker] = useState<boolean>(false);
  const [showDayPicker, setShowDayPicker] = useState<boolean>(false);
  const [tempSelectedDate, setTempSelectedDate] = useState<string>(date.replace(/\./g, '-'));
  const [selectedDay, setSelectedDay] = useState<number>(
    date ? parseInt(date.split('.')[2], 10) : new Date().getDate()
  );
  const [showAmountAlert, setShowAmountAlert] = useState<boolean>(false);
  const [showCategoryAlert, setShowCategoryAlert] = useState<boolean>(false);
  const [showDeleteAlert, setShowDeleteAlert] = useState<boolean>(false);
  const [showWeekendConfirm, setShowWeekendConfirm] = useState<boolean>(false);
  const [showRecurringEditConfirm, setShowRecurringEditConfirm] = useState<boolean>(false);
  const [showNoChangesAlert, setShowNoChangesAlert] = useState<boolean>(false);
  const [editOnlyThis, setEditOnlyThis] = useState<boolean>(false);
  
  
  // Toast state
  const [showToast, setShowToast] = useState<boolean>(false);
  const [toastMessage, setToastMessage] = useState<string>('');
  
  // Keyboard height tracking
  const [keyboardHeight, setKeyboardHeight] = useState(0);
  
  // Memo section position tracking
  const [memoSectionY, setMemoSectionY] = useState(0);
  
  useEffect(() => {
    const keyboardWillShow = Keyboard.addListener(
      Platform.OS === 'ios' ? 'keyboardWillShow' : 'keyboardDidShow',
      (e) => {
        setKeyboardHeight(e.endCoordinates.height);
      }
    );
    const keyboardWillHide = Keyboard.addListener(
      Platform.OS === 'ios' ? 'keyboardWillHide' : 'keyboardDidHide',
      () => {
        setKeyboardHeight(0);
      }
    );
    
    return () => {
      keyboardWillShow.remove();
      keyboardWillHide.remove();
    };
  }, []);

  // Check if selected date is weekend
  const isWeekend = useCallback(() => {
    // Parse date format "2025.09.28" to Date object
    const parts = date.split('.');
    if (parts.length !== 3) return false;
    
    const year = parseInt(parts[0], 10);
    const month = parseInt(parts[1], 10) - 1; // Month is 0-indexed
    const day = parseInt(parts[2], 10);
    
    const dateObj = new Date(year, month, day);
    const dayOfWeek = dateObj.getDay();
    
    return dayOfWeek === 0 || dayOfWeek === 6; // Sunday or Saturday
  }, [date]);


  const handleCategoryPress = () => {
    console.log('🔘 [액션] 카테고리 선택 버튼 클릭');
    
    
    // 키패드가 열려있으면 닫기
    Keyboard.dismiss();
    
    // 카테고리 선택 화면으로 이동 (현재 선택된 카테고리 전달)
    router.push({
      pathname: '/expense-category',
      params: { 
        selectedCategory: category,
        fromEdit: 'true'
      },
    });
  };

  const handleDatePress = () => {
    console.log('🔘 [액션] 날짜 선택 버튼 클릭');
    
    
    // 키패드가 열려있으면 닫기
    Keyboard.dismiss();
    
    setTempSelectedDate(date.replace(/\./g, '-'));
    setShowDatePicker(true);
  };

  const handleDatePickerClose = () => {
    setShowDatePicker(false);
  };
  
  const handleDateConfirm = () => {
    console.log('✅ [액션] 날짜 선택 확인:', tempSelectedDate);
    if (tempSelectedDate) {
      const formattedDate = tempSelectedDate.replace(/-/g, '.');
      setDate(formattedDate);
    }
    setShowDatePicker(false);
  };


  const handleMemoFocus = () => {
    // 메모 섹션 위치로 스크롤 (삭제 버튼 제외)
    // 기기 화면 높이에 비례하여 스크롤 오프셋 계산
    // 아이폰 13 미니(812pt)에서 216px이 최적 → 약 26.6%
    setTimeout(() => {
      if (memoSectionY > 0) {
        const windowHeight = Dimensions.get('window').height;
        const scrollOffset = windowHeight * 0.266; // 화면 높이의 26.6%
        scrollViewRef.current?.scrollTo({ 
          y: memoSectionY - scrollOffset, 
          animated: true 
        });
      }
    }, 350);
  };

  const handleConfirm = async () => {
    console.log('✅ [액션] 확인 버튼 클릭');
    console.log('📊 [데이터] 수정 내용:', { category, amount, date, memo, isRecurring });
    console.log('🔍 [검증] 기록 유형 확인:', { 
      isEditingRecurring, 
      isEditingAutoGenerated,
      recordDataType: recordData?.type,
      recordDataIsRecurring: recordData?.isRecurring,
    });
    
    // 필수값 검증
    if (!category) {
      console.log('⚠️ [검증] 카테고리 미선택');
      setShowCategoryAlert(true);
      return;
    }
    
    if (!amount || amount === '0' || amount.trim() === '') {
      console.log('⚠️ [검증] 금액 미입력');
      setShowAmountAlert(true);
      return;
    }
    
    
    // 정기 지출 기록(부모 또는 자식) 수정 시 변경사항 확인
    if (recordData?.isRecurring || isEditingAutoGenerated) {
      const hasChanges = 
        category !== recordData?.category ||
        parseFloat(amount.replace(/,/g, '')) !== recordData?.amount ||
        date !== recordData?.date ||
        memo !== recordData?.memo ||
        isRecurring !== recordData?.isRecurring ||
        weekendOption !== recordData?.weekendOption;
      
      if (!hasChanges) {
        // 변경사항 없음 → 얼럿 표시
        console.log('ℹ️ [검증] 변경사항 없음 → 얼럿 표시');
        setShowNoChangesAlert(true);
        return;
      }
      
      // 변경사항 있음 → 확인 모달 표시
      console.log('🔄 [검증] 정기 지출 기록 변경 감지 → 모달 표시');
      console.log('📊 [검증] 기록 유형:', { isEditingAutoGenerated, isOriginalRecurring: recordData?.isRecurring });
      console.log('📊 [검증] 수정 옵션:', { editOnlyThis });
      
      setShowRecurringEditConfirm(true);
      return;
    }
    
    // 정기 지출 + 주말인 경우 확인 모달 표시 (모든 주말 옵션에 대해)
    if (isRecurring && isWeekend()) {
      console.log('📅 [검증] 정기 지출 + 주말 → 확인 모달 표시');
      setShowWeekendConfirm(true);
      return;
    }
    
    // 실제 저장 진행
    console.log('💾 [저장] 수정 내역 저장 시작');
    console.log('🔍 [저장] 일반 소비 기록 수정 - saveExpenseEdit 호출');
    await saveExpenseEdit();
  };
  
  const saveExpenseEdit = async () => {
    console.log('💾 [저장] saveExpenseEdit 함수 실행');
    try {
      const storedData = await AsyncStorage.getItem('calendarData');
      const calendarData = storedData ? JSON.parse(storedData) : {};
      
      const expenseAmount = parseFloat(amount.replace(/,/g, ''));
      console.log('📊 [저장] 파싱된 금액:', expenseAmount);
      
      // 1. 기존 기록 확인 및 제거
      console.log('🗑️ [저장] 기존 기록 삭제:', { dateKey, recordIndex });
      console.log('🔍 [저장] 현재 수정하려는 기록:', recordData);
      if (calendarData[dateKey] && calendarData[dateKey].records) {
        const originalRecord = calendarData[dateKey].records[recordIndex];
        if (originalRecord) {
          console.log('📌 [저장] 삭제할 기록:', originalRecord);
          console.log('⚠️ [저장] 기록 일치 여부:', {
            categoryMatch: originalRecord.category === recordData.category,
            amountMatch: originalRecord.amount === recordData.amount,
            timestampMatch: originalRecord.timestamp === recordData.timestamp
          });
          
          // 안전 검증: 기록이 일치하지 않으면 삭제하지 않음
          if (originalRecord.category !== recordData.category || 
              originalRecord.amount !== recordData.amount || 
              originalRecord.timestamp !== recordData.timestamp) {
            console.error('❌ [저장] 기록 불일치! 삭제 중단');
            console.error('❌ [저장] 예상:', recordData);
            console.error('❌ [저장] 실제:', originalRecord);
            return; // 삭제하지 않고 함수 종료
          }
          
          // 1-1. 자동생성된 기록인지 확인
          const isEditingAutoGenerated = originalRecord.isAutoGenerated === true;
          const parentRecurringId = originalRecord.recurringId;
          
          console.log('🔍 [저장] 기록 유형:', { isEditingAutoGenerated, parentRecurringId });
          
          // 1-1-1. 할부 기록 수정
          if (originalRecord.isInstallment) {
            console.log('💳 [저장] 할부 기록 수정');
            
            // 선납 처리 체크 시
            if (isPrepaidChecked && !originalRecord.isPrepaid) {
              console.log('💰 [선납] 선납 처리 시작');
              
              // 기존 기록을 삭제 (0원으로 변경하지 않고 완전 삭제)
              calendarData[dateKey].totalExpense = Math.max(0, calendarData[dateKey].totalExpense - originalRecord.amount);
              calendarData[dateKey].records.splice(recordIndex, 1);
              
              console.log('✅ [선납] 기존 기록 삭제 완료');
              
              // 선납 날짜는 현재 날짜 그대로 사용 (주말옵션 적용 안함)
              const today = new Date();
              const prepaidDateKey = `${today.getFullYear()}-${String(today.getMonth() + 1).padStart(2, '0')}-${String(today.getDate()).padStart(2, '0')}`;
              
              console.log('📅 [선납] 선납 날짜 (주말옵션 미적용):', prepaidDateKey);
              
              if (!calendarData[prepaidDateKey]) {
                calendarData[prepaidDateKey] = {
                  totalExpense: 0,
                  totalIncome: 0,
                  records: [],
                };
              }
              
              // 선납 소비 기록 추가
              const installmentIdForPrepaid = recordData.installmentId || recordData.timestamp?.toString();
              calendarData[prepaidDateKey].records.push({
                type: 'expense' as const,
                amount: recordData.amount,
                category,
                memo: memo || '', // 메모에 선납 텍스트 추가하지 않음
                date: prepaidDateKey.replace(/-/g, '.'),
                timestamp: new Date().getTime(),
                isRecurring: false,
                isInstallment: true,
                installmentId: installmentIdForPrepaid,
                installmentMonths: recordData.installmentMonths,
                isPrepaid: true,
                prepaidDate: prepaidDateKey.replace(/-/g, '.'),
                weekendOption: weekendOption,
                originalInstallmentDate: recordData.originalInstallmentDate || recordData.date, // 원본 할부 생성일 저장
                originalScheduledDate: recordData.date, // 원래 할부 예정일 저장 (선납 취소 시 되돌릴 날짜)
              });
              
              calendarData[prepaidDateKey].totalExpense += recordData.amount;
              console.log('✅ [선납] 선납 기록 추가:', prepaidDateKey, recordData.amount.toLocaleString() + '원');
            } else {
              // 일반 수정 (금액, 개월수, 메모, 날짜 변경)
              console.log('📝 [저장] 할부 기록 일반 수정');
              
              // 날짜 변경 시
              const newDateKey = date.replace(/\./g, '-');
              if (newDateKey !== dateKey) {
                console.log('📅 [저장] 날짜 변경:', dateKey, '→', newDateKey);
                
                // 기존 기록 삭제
                calendarData[dateKey].totalExpense = Math.max(0, calendarData[dateKey].totalExpense - originalRecord.amount);
                calendarData[dateKey].records.splice(recordIndex, 1);
                
                // 빈 날짜 정리
                if (calendarData[dateKey].records.length === 0 && (calendarData[dateKey].totalIncome || 0) === 0) {
                  delete calendarData[dateKey];
                  console.log('🗑️ [저장] 빈 날짜 삭제:', dateKey);
                }
                
                // 새 날짜에 기록 추가
                if (!calendarData[newDateKey]) {
                  calendarData[newDateKey] = {
                    totalExpense: 0,
                    totalIncome: 0,
                    records: [],
                  };
                }
                
                // 수정된 기록 생성
                const updatedRecord = {
                  ...originalRecord,
                  amount: expenseAmount,
                  category,
                  memo,
                  date: date,
                  installmentMonths: installmentMonths,
                };
                
                calendarData[newDateKey].records.push(updatedRecord);
                calendarData[newDateKey].totalExpense += expenseAmount;
                
                console.log('✅ [저장] 새 날짜에 기록 추가:', newDateKey);
                
                // 저장하고 새 날짜로 이동
                await AsyncStorage.setItem('calendarData', JSON.stringify(calendarData));
                console.log('✅ [저장] AsyncStorage 저장 완료');
                
                const [targetYear, targetMonth, targetDay] = newDateKey.split('-').map(Number);
                router.back();
                setTimeout(() => {
                  router.replace({
                    pathname: '/(tabs)/home',
                    params: {
                      targetYear: targetYear.toString(),
                      targetMonth: targetMonth.toString(),
                      targetDay: targetDay.toString(),
                      targetDate: newDateKey,
                      periodType: 'month',
                    },
                  });
                }, 100);
                return;
              }
              
              // 금액 변경 시
              if (expenseAmount !== originalRecord.amount) {
                const amountDiff = expenseAmount - originalRecord.amount;
                calendarData[dateKey].totalExpense += amountDiff;
                originalRecord.amount = expenseAmount;
                console.log('💰 [저장] 금액 수정:', recordData.amount, '→', expenseAmount);
              }
              
              // 카테고리 변경
              if (category !== originalRecord.category) {
                originalRecord.category = category;
                console.log('🏷️ [저장] 카테고리 수정:', recordData.category, '→', category);
              }
              
              // 메모 변경
              if (memo !== originalRecord.memo) {
                originalRecord.memo = memo;
                console.log('📝 [저장] 메모 수정:', recordData.memo, '→', memo);
              }
              
              // 할부 개월수 변경
              if (installmentMonths !== originalRecord.installmentMonths) {
                originalRecord.installmentMonths = installmentMonths;
                console.log('📅 [저장] 할부 개월수 수정:', recordData.installmentMonths, '→', installmentMonths);
              }
            }
            
            // 날짜 변경이 아닌 경우에만 저장하고 홈으로 이동
            if (date.replace(/\./g, '-') === dateKey) {
              await AsyncStorage.setItem('calendarData', JSON.stringify(calendarData));
              console.log('✅ [저장] AsyncStorage 저장 완료');
              
              const [targetYear, targetMonth, targetDay] = dateKey.split('-').map(Number);
              router.back();
              setTimeout(() => {
                router.replace({
                  pathname: '/(tabs)/home',
                  params: {
                    targetYear: targetYear.toString(),
                    targetMonth: targetMonth.toString(),
                    targetDay: targetDay.toString(),
                    targetDate: dateKey,
                    periodType: 'month',
                  },
                });
              }, 100);
              return;
            }
          }
          
          if (isEditingAutoGenerated) {
            // 자동생성된 기록 수정
            console.log('⚠️ [저장] 자동생성된 기록 수정');
            console.log('📊 [저장] editOnlyThis:', editOnlyThis);
            
            if (editOnlyThis) {
              // 오늘(자식) 기록만 수정 → 기존 기록 삭제 후 새 날짜에 추가
              console.log('📝 [저장] 오늘(자식) 기록만 수정 → 기존 기록 삭제');
              
              // 기존 기록 삭제
              console.log('🗑️ [저장] 자식 기록 삭제: ', dateKey);
              calendarData[dateKey].totalExpense = Math.max(0, (calendarData[dateKey].totalExpense || 0) - originalRecord.amount);
              calendarData[dateKey].records.splice(recordIndex, 1);
              
              // 빈 날짜 정리
              if (calendarData[dateKey].records.length === 0 && (calendarData[dateKey].totalIncome || 0) === 0) {
                delete calendarData[dateKey];
                console.log('🗑️ [저장] 빈 날짜 삭제:', dateKey);
              }
            } else {
              // 전체 데이터 수정 → 원본 생성 시점 년/월 유지하여 재생성
              console.log('🔁 [저장] 전체 데이터 수정 (자식) → 원본 년/월 기준 재생성');
              
              const parentRecurringId = originalRecord.recurringId;
              console.log('🔍 [저장] recurringId:', parentRecurringId);
              
              // 1단계: 모든 관련 기록 찾아서 년/월 추출
              const yearMonthsSet = new Set<string>();
              Object.keys(calendarData).forEach(key => {
                if (calendarData[key].records) {
                  calendarData[key].records.forEach((r: any) => {
                    if (r.recurringId === parentRecurringId) {
                      const [year, month] = key.split('-');
                      yearMonthsSet.add(`${year}-${month}`);
                    }
                  });
                }
              });
              
              const yearMonths = Array.from(yearMonthsSet).sort();
              console.log('📅 [저장] 추출된 년/월 리스트:', yearMonths);
              
              // 2단계: 모든 기록 삭제
              let deletedCount = 0;
              Object.keys(calendarData).forEach(key => {
                if (calendarData[key].records) {
                  const recordsToDelete = calendarData[key].records.filter(
                    (r: any) => r.recurringId === parentRecurringId
                  );
                  
                  recordsToDelete.forEach((r: any) => {
                    const index = calendarData[key].records.indexOf(r);
                    if (index > -1) {
                      calendarData[key].totalExpense = Math.max(0, (calendarData[key].totalExpense || 0) - r.amount);
                      calendarData[key].records.splice(index, 1);
                      deletedCount++;
                      console.log('🗑️ [저장] 기록 삭제:', key, '금액:', r.amount.toLocaleString() + '원');
                    }
                  });
                  
                  // 빈 날짜 삭제
                  if (calendarData[key].records.length === 0 && (calendarData[key].totalIncome || 0) === 0) {
                    delete calendarData[key];
                  }
                }
              });
              
              console.log('✅ [저장] 모든 연관 기록', deletedCount, '개 삭제 완료');
              
              // 3단계: 원본 년/월 기준으로 재생성 (일자만 변경)
              console.log('🔄 [저장] 원본 년/월 기준 재생성 시작');
              
              yearMonths.forEach((yearMonth, index) => {
                const [yearStr, monthStr] = yearMonth.split('-');
                const yearNum = parseInt(yearStr, 10);
                const monthNum = parseInt(monthStr, 10);
                
                // 선택한 일자에 월말 처리 적용
                const [_, __, selectedDayNum] = date.split('.').map(Number);
                const actualDay = getActualDayForMonth(yearNum, monthNum, selectedDayNum);
                
                // 날짜 생성
                let newDate = `${yearNum}.${String(monthNum).padStart(2, '0')}.${String(actualDay).padStart(2, '0')}`;
                
                // 주말이면 조정
                const dateObj = new Date(yearNum, monthNum - 1, actualDay);
                const dayOfWeek = dateObj.getDay();
                
                if ((dayOfWeek === 0 || dayOfWeek === 6) && weekendOption !== 'weekend') {
                  newDate = getAdjustedWeekendDate(newDate, weekendOption);
                }
                
                const newDateKey = newDate.replace(/\./g, '-');
                
                // 데이터 구조 생성
                if (!calendarData[newDateKey]) {
                  calendarData[newDateKey] = {
                    totalExpense: 0,
                    totalIncome: 0,
                    records: [],
                  };
                }
                
                // 새 기록 추가
                const isParent = index === 0; // 첫 번째 월이 부모
                const newTimestamp = new Date().getTime() + index;
                
                calendarData[newDateKey].records.push({
                  type: 'expense' as const,
                  amount: expenseAmount,
                  category,
                  memo,
                  date: newDate,
                  timestamp: newTimestamp,
                  isRecurring: true,
                  isInstallment: false,
                  weekendOption,
                  recurringId: parentRecurringId,
                  isAutoGenerated: !isParent,
                });
                
                calendarData[newDateKey].totalExpense += expenseAmount;
                console.log('✅ [저장] 재생성:', newDate, '금액:', expenseAmount.toLocaleString() + '원', 'isParent:', isParent);
              });
              
              console.log('✅ [저장] 모든 년/월 기준 재생성 완료');
              
              // 재생성 완료 후 저장하고 종료
              await AsyncStorage.setItem('calendarData', JSON.stringify(calendarData));
              console.log('✅ [저장] AsyncStorage 저장 완료');
              
              const [targetYear, targetMonth, targetDay] = dateKey.split('-').map(Number);
              router.back();
              setTimeout(() => {
                router.replace({
                  pathname: '/(tabs)/home',
                  params: {
                    targetYear: targetYear.toString(),
                    targetMonth: targetMonth.toString(),
                    targetDay: targetDay.toString(),
                    targetDate: dateKey,
                    periodType: 'month',
                  },
                });
              }, 100);
              return;
            }
          } else if (originalRecord.isRecurring) {
            // 원본 정기 지출 기록 수정
            console.log('🔁 [저장] 원본 정기 지출 기록 수정');
            console.log('📊 [저장] editOnlyThis:', editOnlyThis);
            
            if (editOnlyThis) {
              // 오늘(원본) 기록만 수정 → 자식들은 그대로 유지
              console.log('📝 [저장] 오늘(원본) 기록만 수정 → 자식 유지');
              
              // 원본 기록 삭제 (날짜가 변경되었을 수 있으므로)
              console.log('🗑️ [저장] 원본 기록 삭제: ', dateKey);
              calendarData[dateKey].totalExpense = Math.max(0, (calendarData[dateKey].totalExpense || 0) - originalRecord.amount);
              calendarData[dateKey].records.splice(recordIndex, 1);
              
              // 빈 날짜 정리
              if (calendarData[dateKey].records.length === 0 && (calendarData[dateKey].totalIncome || 0) === 0) {
                delete calendarData[dateKey];
                console.log('🗑️ [저장] 빈 날짜 삭제:', dateKey);
              }
            } else {
              // 전체 데이터 수정 → 원본 생성 시점 년/월 유지하여 재생성
              console.log('🔁 [저장] 전체 데이터 수정 (부모) → 원본 년/월 기준 재생성');
            
              // 원본 기록의 recurringId 가져오기
              const originalRecurringId = originalRecord.recurringId || originalRecord.timestamp?.toString();
              console.log('🔍 [저장] recurringId:', originalRecurringId);
              
              // 1단계: 모든 관련 기록 찾아서 년/월 추출
              const yearMonthsSet = new Set<string>();
              Object.keys(calendarData).forEach(key => {
                if (calendarData[key].records) {
                  calendarData[key].records.forEach((r: any) => {
                    if (r.recurringId === originalRecurringId) {
                      const [year, month] = key.split('-');
                      yearMonthsSet.add(`${year}-${month}`);
                    }
                  });
                }
              });
              
              const yearMonths = Array.from(yearMonthsSet).sort();
              console.log('📅 [저장] 추출된 년/월 리스트:', yearMonths);
              
              // 2단계: 모든 기록 삭제
              let deletedCount = 0;
              Object.keys(calendarData).forEach(key => {
                if (calendarData[key].records) {
                  const recordsToDelete = calendarData[key].records.filter(
                    (r: any) => r.recurringId === originalRecurringId
                  );
                  
                  recordsToDelete.forEach((r: any) => {
                    const index = calendarData[key].records.indexOf(r);
                    if (index > -1) {
                      calendarData[key].totalExpense = Math.max(0, (calendarData[key].totalExpense || 0) - r.amount);
                      calendarData[key].records.splice(index, 1);
                      deletedCount++;
                      console.log('🗑️ [저장] 기록 삭제:', key, '금액:', r.amount.toLocaleString() + '원');
                    }
                  });
                  
                  // 빈 날짜 삭제
                  if (calendarData[key].records.length === 0 && (calendarData[key].totalIncome || 0) === 0) {
                    delete calendarData[key];
                  }
                }
              });
              
              console.log('✅ [저장] 모든 연관 기록', deletedCount, '개 삭제 완료');
              
              // 3단계: 원본 년/월 기준으로 재생성 (일자만 변경)
              console.log('🔄 [저장] 원본 년/월 기준 재생성 시작');
              
              yearMonths.forEach((yearMonth, index) => {
                const [yearStr, monthStr] = yearMonth.split('-');
                const yearNum = parseInt(yearStr, 10);
                const monthNum = parseInt(monthStr, 10);
                
                // 선택한 일자에 월말 처리 적용
                const [_, __, selectedDayNum] = date.split('.').map(Number);
                const actualDay = getActualDayForMonth(yearNum, monthNum, selectedDayNum);
                
                // 날짜 생성
                let newDate = `${yearNum}.${String(monthNum).padStart(2, '0')}.${String(actualDay).padStart(2, '0')}`;
                
                // 주말이면 조정
                const dateObj = new Date(yearNum, monthNum - 1, actualDay);
                const dayOfWeek = dateObj.getDay();
                
                if ((dayOfWeek === 0 || dayOfWeek === 6) && weekendOption !== 'weekend') {
                  newDate = getAdjustedWeekendDate(newDate, weekendOption);
                }
                
                const newDateKey = newDate.replace(/\./g, '-');
                
                // 데이터 구조 생성
                if (!calendarData[newDateKey]) {
                  calendarData[newDateKey] = {
                    totalExpense: 0,
                    totalIncome: 0,
                    records: [],
                  };
                }
                
                // 새 기록 추가
                const isParent = index === 0; // 첫 번째 월이 부모
                const newTimestamp = new Date().getTime() + index;
                
                calendarData[newDateKey].records.push({
                  type: 'expense' as const,
                  amount: expenseAmount,
                  category,
                  memo,
                  date: newDate,
                  timestamp: newTimestamp,
                  isRecurring: true,
                  isInstallment: false,
                  weekendOption,
                  recurringId: originalRecurringId,
                  isAutoGenerated: !isParent,
                });
                
                calendarData[newDateKey].totalExpense += expenseAmount;
                console.log('✅ [저장] 재생성:', newDate, '금액:', expenseAmount.toLocaleString() + '원', 'isParent:', isParent);
              });
              
              console.log('✅ [저장] 모든 년/월 기준 재생성 완료');
              
              // 재생성 완료 후 저장하고 종료
              await AsyncStorage.setItem('calendarData', JSON.stringify(calendarData));
              console.log('✅ [저장] AsyncStorage 저장 완료');
              
              const [targetYear, targetMonth, targetDay] = dateKey.split('-').map(Number);
              router.back();
              setTimeout(() => {
                router.replace({
                  pathname: '/(tabs)/home',
                  params: {
                    targetYear: targetYear.toString(),
                    targetMonth: targetMonth.toString(),
                    targetDay: targetDay.toString(),
                    targetDate: dateKey,
                    periodType: 'month',
                  },
                });
              }, 100);
              return;
            }
          } else {
            // 일반 기록 수정 → 해당 기록만 수정
            console.log('📝 [저장] 일반 기록 수정');
            
            // 날짜 변경 여부 확인
            const newDateKey = date.replace(/\./g, '-');
            if (newDateKey !== dateKey) {
              console.log('📅 [저장] 일반 기록 날짜 변경:', dateKey, '→', newDateKey);
              
              // 기존 날짜에서 기록 삭제
              calendarData[dateKey].totalExpense = Math.max(0, (calendarData[dateKey].totalExpense || 0) - originalRecord.amount);
              calendarData[dateKey].records.splice(recordIndex, 1);
              console.log('✅ [저장] 기존 날짜에서 기록 삭제 완료');
              
              // 빈 날짜 정리
              if (calendarData[dateKey].records.length === 0 && (calendarData[dateKey].totalIncome || 0) === 0) {
                delete calendarData[dateKey];
                console.log('🗑️ [저장] 빈 날짜 삭제:', dateKey);
              }
              
              // 새 날짜에 기록 추가
              if (!calendarData[newDateKey]) {
                calendarData[newDateKey] = {
                  totalExpense: 0,
                  totalIncome: 0,
                  records: [],
                };
              }
              
              const newRecord = {
                type: 'expense' as const,
                amount: expenseAmount,
                category,
                memo,
                date: date,
                timestamp: new Date().getTime(),
                isRecurring: false,
                isInstallment: false,
              };
              
              calendarData[newDateKey].records.push(newRecord);
              calendarData[newDateKey].totalExpense += expenseAmount;
              console.log('✅ [저장] 새 날짜에 기록 추가 완료:', newDateKey);
              
              // 저장하고 새 날짜로 이동
              await AsyncStorage.setItem('calendarData', JSON.stringify(calendarData));
              console.log('✅ [저장] AsyncStorage 저장 완료');
              
              const [targetYear, targetMonth, targetDay] = newDateKey.split('-').map(Number);
              router.back();
              setTimeout(() => {
                router.replace({
                  pathname: '/(tabs)/home',
                  params: {
                    targetYear: targetYear.toString(),
                    targetMonth: targetMonth.toString(),
                    targetDay: targetDay.toString(),
                    targetDate: newDateKey,
                    periodType: 'month',
                  },
                });
              }, 100);
              return;
            } else {
              // 같은 날짜에서 수정
              calendarData[dateKey].totalExpense = Math.max(0, (calendarData[dateKey].totalExpense || 0) - originalRecord.amount);
              calendarData[dateKey].records.splice(recordIndex, 1);
              console.log('✅ [저장] 기존 기록 삭제 완료');
              
              if (calendarData[dateKey].records.length === 0 && (calendarData[dateKey].totalIncome || 0) === 0) {
                delete calendarData[dateKey];
                console.log('🗑️ [저장] 빈 날짜 삭제:', dateKey);
              }
            }
          }
        }
      }
      
      // 2. 실제 저장될 날짜 계산 (정기 기록만 주말 옵션 적용)
      let actualDate = date;
      
      // 일반 기록은 주말 옵션 없음, 정기 기록만 주말 옵션 적용
      if (isRecurring) {
        // 주말 체크 (함수 호출이 아닌 직접 계산)
        const parts = date.split('.');
        const year = parseInt(parts[0], 10);
        const month = parseInt(parts[1], 10) - 1;
        const day = parseInt(parts[2], 10);
        const dateObj = new Date(year, month, day);
        const dayOfWeek = dateObj.getDay();
        const isWeekendDay = dayOfWeek === 0 || dayOfWeek === 6;
        
        console.log('📅 [저장] 정기 기록 날짜 체크:', { 
          date, 
          year, 
          month: month + 1, 
          day, 
          dayOfWeek, 
          isWeekendDay, 
          isRecurring, 
          weekendOption 
        });
        
        if (isWeekendDay && weekendOption !== 'weekend') {
          actualDate = getAdjustedWeekendDate(date, weekendOption);
          console.log('📅 [저장] 주말 날짜 조정:', date, '→', actualDate);
        } else if (isWeekendDay && weekendOption === 'weekend') {
          console.log('📅 [저장] 관계없이 주말 기록 옵션 → 날짜 조정 안 함:', date);
        }
      } else {
        console.log('📅 [저장] 일반 기록 - 주말 옵션 없음:', date);
      }
      
      const actualDateKey = actualDate.replace(/\./g, '-');
      console.log('📅 [저장] 실제 저장 날짜:', actualDateKey);
      
      // 3. 새 날짜에 데이터 구조 생성
      if (!calendarData[actualDateKey]) {
        calendarData[actualDateKey] = {
          totalExpense: 0,
          totalIncome: 0,
          records: [],
        };
      }
      
      // 4. 새 기록 추가
      const newTimestamp = new Date().getTime();
      
      // recurringId 결정
      let recurringId: string | undefined = undefined;
      let isAutoGenerated: boolean | undefined = undefined;
      
      if (isRecurring) {
        if (isEditingAutoGenerated) {
          // 자동생성 기록 수정 시: 부모의 recurringId 유지, 여전히 자동생성 상태
          recurringId = recordData?.recurringId;
          isAutoGenerated = true;
          console.log('♻️ [저장] 자동생성 기록 - 부모 recurringId 유지:', recurringId);
        } else if (recordData?.isRecurring && recordData?.recurringId) {
          // 원본 기록 수정 시: 기존 recurringId 재사용
          recurringId = recordData.recurringId;
          console.log('♻️ [저장] 원본 기록 - 기존 recurringId 재사용:', recurringId);
        } else if (recordData?.isRecurring && recordData?.timestamp) {
          // 정기 지출이었지만 recurringId 없으면 timestamp 사용
          recurringId = recordData.timestamp.toString();
          console.log('🔄 [저장] 기존 timestamp를 recurringId로 사용:', recurringId);
        } else {
          // 새로운 정기 지출이면 새 ID 생성
          recurringId = newTimestamp.toString();
          console.log('🆕 [저장] 새 recurringId 생성:', recurringId);
        }
      } else if (isEditingAutoGenerated) {
        // 자동생성 기록에서 정기 지출 OFF → 독립 데이터로 전환
        recurringId = undefined;
        isAutoGenerated = false;
        console.log('🔓 [저장] 독립 데이터로 전환 (recurringId 제거)');
      }
      
      const newRecord = {
        type: 'expense' as const,
        amount: expenseAmount,
        category,
        memo,
        date: actualDate,
        timestamp: newTimestamp,
        isRecurring,
        isInstallment,
        installmentMonths: isInstallment ? installmentMonths : undefined,
        weekendOption: isRecurring ? weekendOption : undefined,
        recurringId: recurringId,
        isAutoGenerated: isAutoGenerated,
      };
      
      calendarData[actualDateKey].records.push(newRecord);
      calendarData[actualDateKey].totalExpense = (calendarData[actualDateKey].totalExpense || 0) + expenseAmount;
      console.log('✅ [저장] 새 기록 추가 완료:', actualDateKey);
      console.log('📌 [저장] 최종 recurringId:', recurringId);
      
      // 5. 정기 지출인 경우 다음 달들에도 기록 생성 (향후 12개월)
      // 조건: 
      // - 현재 정기 지출이 켜져 있고
      // - 다음 중 하나:
      //   1. 일반 기록이었거나
      //   2. 일반 기록에서 정기 지출로 변경했거나
      //   3. 정기 지출 기록을 "전체 변경"한 경우
      const wasNotRecurring = recordData?.isRecurring === false;
      const isNowRecurring = isRecurring === true;
      const isFullUpdate = !editOnlyThis; // 전체 변경인 경우
      const shouldGenerateRecurring = isNowRecurring && (!isEditingAutoGenerated || wasNotRecurring || isFullUpdate);
      
      if (shouldGenerateRecurring) {
        console.log('🔁 [저장] 정기 지출 처리 시작 (향후 12개월)');
        // 원래 선택한 날짜를 기준으로 다음 달 계산 (조정된 날짜가 아님!)
        const [year, month, day] = date.split('.').map(Number);
        console.log('📅 [저장] 기준 날짜:', date, '(원래 선택한 날짜)');
        
        for (let i = 1; i <= 12; i++) {
          let futureMonth = month + i;
          let futureYear = year;
          
          // 월이 12를 넘으면 연도 증가
          while (futureMonth > 12) {
            futureMonth -= 12;
            futureYear += 1;
          }
          
          // 월말 처리: 해당 월의 실제 일자 계산
          const actualDay = getActualDayForMonth(futureYear, futureMonth, day);
          
          // 미래 날짜 생성
          let futureDate = `${futureYear}.${String(futureMonth).padStart(2, '0')}.${String(actualDay).padStart(2, '0')}`;
          
          // 주말이면 조정 (단, 'weekend' 옵션이 아닐 때만)
          const futureDateObj = new Date(futureYear, futureMonth - 1, actualDay);
          const dayOfWeek = futureDateObj.getDay();
          
          if ((dayOfWeek === 0 || dayOfWeek === 6) && weekendOption !== 'weekend') {
            futureDate = getAdjustedWeekendDate(futureDate, weekendOption);
          }
          
          const futureDateKey = futureDate.replace(/\./g, '-');
          
          // 미래 날짜에 데이터 구조 생성
          if (!calendarData[futureDateKey]) {
            calendarData[futureDateKey] = {
              totalExpense: 0,
              totalIncome: 0,
              records: [],
            };
          }
          
          // 미래 기록 추가 (자동생성 표시)
          calendarData[futureDateKey].records.push({
            ...newRecord,
            date: futureDate,
            timestamp: new Date().getTime() + i, // 순서 보장
            recurringId: recurringId,           // 원본 기록 ID
            isAutoGenerated: true,               // 자동생성 기록 표시
          });
          
          calendarData[futureDateKey].totalExpense = (calendarData[futureDateKey].totalExpense || 0) + expenseAmount;
          console.log('📅 [저장] 자동생성 기록 추가:', futureDateKey, '금액:', expenseAmount.toLocaleString() + '원');
        }
        console.log('✅ [저장] 정기 지출 12개월 생성 완료');
      }
      
      // 6. 할부인 경우 다음 달들에 분할 기록 생성
      if (isInstallment && installmentMonths > 1) {
        console.log('💳 [저장] 할부 처리 시작:', installmentMonths, '개월');
        const [year, month, day] = actualDate.split('.').map(Number);
        const monthlyAmount = Math.floor(expenseAmount / installmentMonths);
        console.log('💰 [저장] 월별 할부 금액:', monthlyAmount);
        
        for (let i = 1; i < installmentMonths; i++) {
          let futureMonth = month + i;
          let futureYear = year;
          
          while (futureMonth > 12) {
            futureMonth -= 12;
            futureYear += 1;
          }
          
          const futureDate = `${futureYear}.${String(futureMonth).padStart(2, '0')}.${String(day).padStart(2, '0')}`;
          const futureDateKey = futureDate.replace(/\./g, '-');
          
          if (!calendarData[futureDateKey]) {
            calendarData[futureDateKey] = {
              totalExpense: 0,
              totalIncome: 0,
              records: [],
            };
          }
          
          calendarData[futureDateKey].records.push({
            ...newRecord,
            amount: monthlyAmount,
            date: futureDate,
            timestamp: new Date().getTime() + i,
          });
          
          calendarData[futureDateKey].totalExpense = (calendarData[futureDateKey].totalExpense || 0) + monthlyAmount;
        }
        console.log('✅ [저장] 할부', installmentMonths - 1, '개월 생성 완료');
      }
      
      // 7. AsyncStorage에 저장
      await AsyncStorage.setItem('calendarData', JSON.stringify(calendarData));
      console.log('✅ [저장] AsyncStorage 저장 완료');
      
      // 8. 홈으로 이동
      const [targetYear, targetMonth, targetDay] = actualDateKey.split('-').map(Number);
      console.log('🏠 [이동] 홈 화면으로 이동:', { targetYear, targetMonth, targetDay });
      
      router.back();
      
      setTimeout(() => {
        router.replace({
          pathname: '/(tabs)/home',
          params: {
            targetYear: targetYear.toString(),
            targetMonth: targetMonth.toString(),
            targetDay: targetDay.toString(),
            targetDate: actualDateKey,
            periodType: 'month',
          },
        });
      }, 100);
    } catch (error) {
      console.error('❌ [에러] 저장 실패:', error);
    }
  };
  
  // 주말 날짜를 금요일 또는 월요일로 조정하는 함수
  const getAdjustedWeekendDate = (dateString: string, option: 'friday' | 'monday'): string => {
    const [year, month, day] = dateString.split('.').map(Number);
    const dateObj = new Date(year, month - 1, day);
    const dayOfWeek = dateObj.getDay();
    
    if (dayOfWeek === 0) {
      // 일요일
      if (option === 'friday') {
        // 금주 금요일 = -2일
        dateObj.setDate(dateObj.getDate() - 2);
      } else {
        // 차주 월요일 = +1일
        dateObj.setDate(dateObj.getDate() + 1);
      }
    } else if (dayOfWeek === 6) {
      // 토요일
      if (option === 'friday') {
        // 금주 금요일 = -1일
        dateObj.setDate(dateObj.getDate() - 1);
      } else {
        // 차주 월요일 = +2일
        dateObj.setDate(dateObj.getDate() + 2);
      }
    }
    
    const adjustedYear = dateObj.getFullYear();
    const adjustedMonth = String(dateObj.getMonth() + 1).padStart(2, '0');
    const adjustedDay = String(dateObj.getDate()).padStart(2, '0');
    
    return `${adjustedYear}.${adjustedMonth}.${adjustedDay}`;
  };

  // 원래 할부 날짜 계산 (주말옵션 적용)
  const getOriginalInstallmentDate = async (): Promise<string> => {
    // 선납 기록의 원래 할부 날짜를 찾기
    try {
      const currentRecord = recordData;
      if (!currentRecord) return '';
      
      // originalInstallmentDate가 있으면 바로 사용
      if (currentRecord.originalInstallmentDate) {
        const originalDate = currentRecord.originalInstallmentDate;
        const [year, month, day] = originalDate.split('.');
        return `${year}/${month}/${day}`;
      }
      
      // originalInstallmentDate가 없는 경우 할부 기록들을 검색하여 찾기
      console.log('⚠️ [원래날짜] originalInstallmentDate 없음 → 할부 기록 검색');
      
      // 선납 기록이 어느 월의 할부인지 파악하기 위해 할부 기록들을 검색
      // 실제로는 AsyncStorage에서 검색해야 하지만, 모달 표시용이므로 간단한 추정
      
      // 선납 기록의 정보로 원래 할부 기록일 추정
      // 날짜 형식 처리: "2025-12-19" 또는 "2025.12.19"
      const dateStr = currentRecord.date.replace(/\./g, '-');
      const [yearStr, monthStr, dayStr] = dateStr.split('-');
      const targetDay = parseInt(dayStr);
      const targetAmount = currentRecord.amount;
      const targetMonths = currentRecord.installmentMonths;
      const targetCategory = currentRecord.category;
      
      console.log('🔍 [원래날짜] 찾을 조건:', { targetDay, targetAmount, targetMonths, targetCategory });
      
      // 선납 기록에서 원래 할부 기록일 추정
      // 할부 그룹에서 가장 이른 날짜를 찾아야 함
      try {
        const storedData = await AsyncStorage.getItem('calendarData');
        const calendarData = storedData ? JSON.parse(storedData) : {};
        
        // 같은 할부 그룹의 모든 기록 찾기
        const installmentRecords: Array<{ date: string; dateKey: string }> = [];
        
        for (const [dateKey, records] of Object.entries(calendarData)) {
          if (Array.isArray(records)) {
            records.forEach((record: any) => {
              if (record.isInstallment && 
                  record.amount === targetAmount && 
                  record.category === targetCategory &&
                  record.installmentMonths === targetMonths) {
                installmentRecords.push({ date: record.date, dateKey });
              }
            });
          }
        }
        
        if (installmentRecords.length > 0) {
          // 가장 이른 날짜 찾기
          const sortedRecords = installmentRecords.sort((a, b) => 
            new Date(a.date.replace(/\./g, '-')).getTime() - new Date(b.date.replace(/\./g, '-')).getTime()
          );
          
          const originalDate = sortedRecords[0].date.replace(/\./g, '-');
          console.log('📅 [원래날짜] 할부 그룹에서 찾음:', { 
            originalDate,
            totalRecords: installmentRecords.length,
            allDates: installmentRecords.map(r => r.date)
          });
          
          return originalDate.replace(/-/g, '/');
        }
        
        // 할부 기록을 찾지 못한 경우, 임시로 현재 날짜에서 할부 개월수만큼 빼기
        const currentDate = new Date(dateStr);
        const fallbackDate = new Date(currentDate);
        fallbackDate.setMonth(currentDate.getMonth() - (targetMonths || 0));
        
        const year = fallbackDate.getFullYear();
        const month = String(fallbackDate.getMonth() + 1).padStart(2, '0');
        const day = String(targetDay).padStart(2, '0');
        
        console.log('⚠️ [원래날짜] 할부 기록 없음 - 임시 계산:', { 
          fallbackDate: `${year}-${month}-${day}`,
          currentDate: dateStr,
          targetMonths: targetMonths || 0
        });
        
        return `${year}/${month}/${day}`;
        
      } catch (error) {
        console.error('❌ [원래날짜] 할부 기록 검색 오류:', error);
        return dateStr.replace(/-/g, '/');
      }
      
    } catch (error) {
      console.error('❌ [원래날짜] 계산 오류:', error);
      return '';
    }
  };

  // 선납 기록 되돌리기
  const revertPrepaidRecord = async () => {
    console.log('🔄 [되돌리기] 선납 기록을 원래 할부 기록으로 되돌리기');
    try {
      const storedData = await AsyncStorage.getItem('calendarData');
      const calendarData = storedData ? JSON.parse(storedData) : {};
      
      if (calendarData[dateKey] && calendarData[dateKey].records) {
        const recordToRevert = calendarData[dateKey].records[recordIndex];
        
        const isPrepaidRecord = recordToRevert?.isPrepaid || false;
        if (recordToRevert && isPrepaidRecord) {
          console.log('📌 [되돌리기] 되돌릴 선납 기록:', recordToRevert);
          
          // 1. 현재 선납 기록 삭제
          calendarData[dateKey].totalExpense = Math.max(0, calendarData[dateKey].totalExpense - recordToRevert.amount);
          calendarData[dateKey].records.splice(recordIndex, 1);
          console.log('🗑️ [되돌리기] 선납 기록 삭제:', dateKey, recordToRevert.amount.toLocaleString() + '원');
          
          // 2. 원래 예정일에 할부 기록 복원
          const originalScheduledDate = recordToRevert.originalScheduledDate || recordToRevert.originalInstallmentDate || recordToRevert.date;
          const originalDateKey = originalScheduledDate.replace(/\./g, '-');
          
          if (!calendarData[originalDateKey]) {
            calendarData[originalDateKey] = {
              records: [],
              totalIncome: 0,
              totalExpense: 0
            };
          }
          
          // 3. 기존 0원 기록 삭제 (복원 시 중복 방지)
          const existingRecords = calendarData[originalDateKey].records;
          const zeroAmountRecordIndex = existingRecords.findIndex((record: any) => 
            record.amount === 0 && 
            record.category === recordToRevert.category &&
            record.isInstallment === true &&
            record.installmentId === recordToRevert.installmentId
          );
          
          if (zeroAmountRecordIndex !== -1) {
            const zeroRecord = existingRecords[zeroAmountRecordIndex];
            calendarData[originalDateKey].records.splice(zeroAmountRecordIndex, 1);
            console.log('🗑️ [되돌리기] 기존 0원 기록 삭제:', originalDateKey, zeroRecord);
          }
          
          // 4. 원래 할부 기록 복원 (메모에서 선납 텍스트 제거)
          const restoredRecord = {
            ...recordToRevert,
            amount: recordToRevert.amount,
            memo: recordToRevert.memo || '', // 메모는 그대로 유지
            isPrepaid: false,
            prepaidDate: undefined,
            originalScheduledDate: undefined
          };
          
          calendarData[originalDateKey].records.push(restoredRecord);
          calendarData[originalDateKey].totalExpense += recordToRevert.amount;
          
          console.log('✅ [되돌리기] 원래 예정일로 복원:', originalDateKey, recordToRevert.amount.toLocaleString() + '원');
          
          // 저장하고 홈으로 이동
          await AsyncStorage.setItem('calendarData', JSON.stringify(calendarData));
          console.log('✅ [되돌리기] AsyncStorage 저장 완료');
          
          router.back();
          setTimeout(() => {
            const [year, month, day] = dateKey.split('-').map(Number);
            router.replace({
              pathname: '/(tabs)/home',
              params: {
                targetYear: year.toString(),
                targetMonth: month.toString(),
                targetDay: day.toString(),
                targetDate: dateKey
              }
            });
          }, 100);
        }
      }
    } catch (error) {
      console.error('❌ [되돌리기] 오류:', error);
    }
  };

  const handleDelete = async () => {
    console.log('🗑️ [액션] 삭제 버튼 클릭');
    try {
      const storedData = await AsyncStorage.getItem('calendarData');
      const calendarData = storedData ? JSON.parse(storedData) : {};
      
      if (calendarData[dateKey] && calendarData[dateKey].records) {
        const recordToDelete = calendarData[dateKey].records[recordIndex];
        
        if (recordToDelete) {
          console.log('📌 [삭제] 삭제할 기록:', recordToDelete);
          
          // 할부 기록이면 모든 할부 기록 삭제
          if (recordToDelete.isInstallment) {
            console.log('💳 [삭제] 할부 기록 → 모든 할부 기록도 삭제');
            
            const installmentIdToDelete = recordToDelete.installmentId || recordToDelete.timestamp?.toString();
            console.log('🔍 [삭제] 삭제할 installmentId:', installmentIdToDelete);
            
            let deletedCount = 0;
            
            // installmentId가 없는 경우 속성 매칭으로 찾기
            if (!recordToDelete.installmentId) {
              console.log('⚠️ [삭제] installmentId 없음 → 속성 매칭으로 찾기');
              
              const targetDay = parseInt(recordToDelete.date.split('.')[2]);
              const targetAmount = recordToDelete.amount;
              const targetMonths = recordToDelete.installmentMonths;
              const targetCategory = recordToDelete.category;
              
              console.log('🔍 [삭제] 찾을 조건:', { targetDay, targetAmount, targetMonths, targetCategory });
              
              // 모든 할부 기록을 한 번에 찾기
              const allRecordsToDelete: Array<{dateKey: string, record: any, index: number}> = [];
              
              Object.keys(calendarData).forEach(key => {
                if (calendarData[key].records) {
                  calendarData[key].records.forEach((r: any, index: number) => {
                    if (r.isInstallment && 
                        r.category === targetCategory &&
                        parseInt(r.date.split('.')[2]) === targetDay &&
                        r.amount === targetAmount &&
                        r.installmentMonths === targetMonths) {
                      console.log('🎯 [삭제] 속성 매칭된 기록:', key, {
                        isInstallment: r.isInstallment,
                        installmentId: r.installmentId,
                        isPrepaid: r.isPrepaid,
                        amount: r.amount,
                        memo: r.memo
                      });
                      allRecordsToDelete.push({ dateKey: key, record: r, index });
                    }
                  });
                }
              });
              
              // 한 번에 모든 할부 기록 삭제
              allRecordsToDelete.forEach(({ dateKey, record, index }) => {
                calendarData[dateKey].totalExpense = Math.max(0, (calendarData[dateKey].totalExpense || 0) - record.amount);
                calendarData[dateKey].records.splice(index, 1);
                deletedCount++;
                console.log('🗑️ [삭제] 할부 기록 삭제:', dateKey, '금액:', record.amount.toLocaleString() + '원');
              });
              
              // 빈 날짜 삭제
              Object.keys(calendarData).forEach(key => {
                if (calendarData[key].records.length === 0 && (calendarData[key].totalIncome || 0) === 0) {
                  delete calendarData[key];
                }
              });
            } else {
              // installmentId가 있는 경우 - 모든 할부 기록을 한 번에 찾기
              const allRecordsToDelete: Array<{dateKey: string, record: any, index: number}> = [];
              
              Object.keys(calendarData).forEach(key => {
                if (calendarData[key].records) {
                  calendarData[key].records.forEach((r: any, index: number) => {
                    // installmentId로 찾거나, installmentId가 없는 경우 fallback
                    const matchById = r.installmentId === installmentIdToDelete;
                    
                    // fallback: installmentId가 없는 기존 데이터인 경우
                    const matchByTimestamp = !r.installmentId && 
                                             r.isInstallment === true && 
                                             Math.abs(r.timestamp - parseInt(installmentIdToDelete)) < 10000;
                    
                    // 선납 기록도 포함 (isPrepaid가 true인 경우)
                    const matchByPrepaid = r.isPrepaid === true && 
                                          (r.installmentId === installmentIdToDelete || 
                                           (!r.installmentId && r.isInstallment === true && 
                                            Math.abs(r.timestamp - parseInt(installmentIdToDelete)) < 10000));
                    
                    const shouldDelete = matchById || matchByTimestamp || matchByPrepaid;
                    
                    if (shouldDelete) {
                      console.log('🎯 [삭제] 매칭된 기록:', key, {
                        isInstallment: r.isInstallment,
                        installmentId: r.installmentId,
                        isPrepaid: r.isPrepaid,
                        amount: r.amount,
                        memo: r.memo
                      });
                      allRecordsToDelete.push({ dateKey: key, record: r, index });
                    }
                  });
                }
              });
              
              // 한 번에 모든 할부 기록 삭제
              allRecordsToDelete.forEach(({ dateKey, record, index }) => {
                calendarData[dateKey].totalExpense = Math.max(0, (calendarData[dateKey].totalExpense || 0) - record.amount);
                calendarData[dateKey].records.splice(index, 1);
                deletedCount++;
                console.log('🗑️ [삭제] 할부 기록 삭제:', dateKey, '금액:', record.amount.toLocaleString() + '원');
              });
              
              // 빈 날짜 삭제
              Object.keys(calendarData).forEach(key => {
                if (calendarData[key].records.length === 0 && (calendarData[key].totalIncome || 0) === 0) {
                  delete calendarData[key];
                }
              });
            }
            
            console.log('✅ [삭제] 연관된 할부 기록', deletedCount, '개 삭제 완료');
            
            // 저장하고 홈으로 이동
            await AsyncStorage.setItem('calendarData', JSON.stringify(calendarData));
            console.log('✅ [삭제] AsyncStorage 저장 완료');
            
            router.back();
            setTimeout(() => {
              const [year, month, day] = dateKey.split('-').map(Number);
              router.replace({
                pathname: '/(tabs)/home',
                params: {
                  targetYear: year.toString(),
                  targetMonth: month.toString(),
                  targetDay: day.toString(),
                  targetDate: dateKey,
                  periodType: 'month',
                },
              });
            }, 100);
            return;
          }
          
          // 원본 정기 지출 기록이면 모든 자동생성 기록도 삭제
          if (recordToDelete.isRecurring && !recordToDelete.isAutoGenerated) {
            console.log('🔁 [삭제] 원본 정기 지출 기록 → 모든 자동생성 기록도 삭제');
            
            // 원본 기록의 recurringId 가져오기
            const recurringIdToDelete = recordToDelete.recurringId || recordToDelete.timestamp?.toString();
            console.log('🔍 [삭제] 삭제할 recurringId:', recurringIdToDelete);
            
            let deletedCount = 0;
            
            // 모든 날짜에서 이 recurringId를 가진 자동생성 기록 삭제
            Object.keys(calendarData).forEach(key => {
              if (calendarData[key].records) {
                const recordsToDelete = calendarData[key].records.filter(
                  (r: any) => r.recurringId === recurringIdToDelete && r.isAutoGenerated
                );
                
                recordsToDelete.forEach((r: any) => {
                  const index = calendarData[key].records.indexOf(r);
                  if (index > -1) {
                    calendarData[key].totalExpense = Math.max(0, (calendarData[key].totalExpense || 0) - r.amount);
                    calendarData[key].records.splice(index, 1);
                    deletedCount++;
                    console.log('🗑️ [삭제] 자동생성 기록 삭제:', key, '금액:', r.amount);
                  }
                });
                
                // 빈 날짜 삭제
                if (calendarData[key].records.length === 0 && (calendarData[key].totalIncome || 0) === 0) {
                  delete calendarData[key];
                }
              }
            });
            
            console.log('✅ [삭제] 연관된 자동생성 기록', deletedCount, '개 삭제 완료');
          }
          
          // 원본 기록 삭제
          const deletedAmount = recordToDelete.amount || 0;
          console.log('🗑️ [삭제] 삭제할 금액:', deletedAmount);
          calendarData[dateKey].totalExpense = Math.max(0, (calendarData[dateKey].totalExpense || 0) - deletedAmount);
          calendarData[dateKey].records.splice(recordIndex, 1);
          console.log('✅ [삭제] 기록 삭제 완료');
          
          // 빈 날짜 삭제
          if (calendarData[dateKey].records.length === 0 && (calendarData[dateKey].totalIncome || 0) === 0) {
            delete calendarData[dateKey];
          }
        }
        
        await AsyncStorage.setItem('calendarData', JSON.stringify(calendarData));
        console.log('✅ [삭제] AsyncStorage 저장 완료');
        
        // 삭제 후 홈으로 이동
        router.back();
        
        setTimeout(() => {
          const [year, month, day] = dateKey.split('-').map(Number);
          router.replace({
            pathname: '/(tabs)/home',
            params: {
              targetYear: year.toString(),
              targetMonth: month.toString(),
              targetDay: day.toString(),
              targetDate: dateKey,
              periodType: 'month',
            },
          });
        }, 100);
      }
    } catch (error) {
      console.error('❌ [에러] 삭제 실패:', error);
    }
  };

  const handleBack = () => {
    console.log('⬅️ [액션] 뒤로가기 버튼 클릭');
    router.back();
  };

  // 카테고리 이모지 찾기
  const getCategoryEmoji = (label: string) => {
    const categories: Record<string, string> = {
      '식비': '🍚',
      '배달음식': '🛵',
      '카페/편의점/간식': '☕️',
      '교통비': '🚊',
      '주거비': '🏠',
      '공과금': '📎',
      '통신비': '☎️',
      '쇼핑': '🛍️',
      '미용': '💇🏻‍♂️',
      '운동/헬스': '💪',
      '구독 서비스': '📌',
      '영화': '🎬',
      '취미': '👨🏻‍💻',
      '여행': '🧳',
      '모임/술': '🍺',
      '경조사/선물': '🎁',
      '차량': '🚘',
      '대출/이자': '🏦',
      '보험': '🔖',
      '적금': '💵',
      '투자': '📈',
      '세금': '⚖️',
      '기타': '📝',
    };
    return categories[label] || '';
  };

  const categoryDisplay = category ? `${getCategoryEmoji(category)} ${category}` : '';

  if (!recordData) {
    return (
      <SafeAreaView style={[styles.container, { backgroundColor: colors.staticWhite }]} edges={['top']}>
        <Text>데이터를 불러올 수 없습니다.</Text>
      </SafeAreaView>
    );
  }

  return (
    <SafeAreaView style={[styles.container, { backgroundColor: colors.staticWhite }]} edges={['top']}>
      <StatusBar barStyle={colorScheme === 'dark' ? 'light-content' : 'dark-content'} />
      
      <TopNavigation
        type="sub"
        title="소비내역 수정"
        showLeftIcon
        onLeftIconPress={handleBack}
      />


      <View style={[styles.content, { backgroundColor: colors.fill }]}>
        <ScrollView 
          ref={scrollViewRef}
          style={styles.scrollView}
          contentContainerStyle={[
            styles.scrollContent, 
            { paddingBottom: keyboardHeight > 0 ? keyboardHeight + 16 - insets.bottom : 16 }
          ]}
          showsVerticalScrollIndicator={false}
          keyboardShouldPersistTaps="handled"
        >
          {/* 소비 내역 타이틀 및 삭제 버튼 */}
          <View style={styles.recordHeaderSection}>
            <Text style={[styles.recordHeaderTitle, { color: colors.staticBlack }]}>
              소비 정보
            </Text>
            <Pressable onPress={() => setShowDeleteAlert(true)}>
              <Text style={[styles.deleteButtonText, { color: colors.textAssistive }]}>
                삭제
              </Text>
            </Pressable>
          </View>

          {/* 소비 정보 박스 */}
          <View style={styles.recordInfo}>
            <View style={[styles.recordCard, { backgroundColor: colors.staticWhite }]}>
              {/* 카테고리 + 금액 행 */}
              <View style={styles.recordRow1}>
                <View style={styles.recordCategoryContainer}>
                  <Text style={[styles.recordCategory, { color: colors.text }]}>
                    {categoryDisplay}
                  </Text>
                </View>
                <View style={styles.recordAmountContainer}>
                  <Text 
                    style={[styles.recordAmount, { color: colors.text }]}
                    adjustsFontSizeToFit
                    numberOfLines={1}
                    minimumFontScale={0.7}
                  >
                    {parseFloat(amount.replace(/,/g, '')).toLocaleString()}원
                  </Text>
                </View>
              </View>
              
              {/* 날짜 + 메모 행 */}
              <View style={styles.recordRow2}>
                <View style={styles.recordDateContainer}>
                  <Text style={[styles.recordDate, { color: colors.textAssistive }]}>
                    {date}
                  </Text>
                </View>
                <View style={styles.recordMemoContainer}>
                  <Text style={[styles.recordMemo, { color: colors.textAssistive }]}>
                    {memo || '메모 없음'}
                  </Text>
                </View>
              </View>
            </View>
          </View>

          {/* 카테고리 */}
          <View style={styles.section}>
            <Text style={[styles.sectionTitle, { color: colors.staticBlack }]}>
              카테고리 <Text style={{ color: '#EF5252' }}>*</Text>
            </Text>
            <Pressable onPress={handleCategoryPress}>
              <View style={[
                styles.dropdown, 
                { 
                  backgroundColor: isEditingInstallment ? colors.fillDisabled : colors.staticWhite, 
                  borderColor: colors.border 
                }
              ]}>
                <Text 
                  style={[styles.dropdownText, { color: isEditingInstallment ? colors.textDisabled : colors.text }]}
                >
                  {categoryDisplay || '카테고리 선택'}
                </Text>
                <Icon 
                  name="arrowRight" 
                  variant="line" 
                  size={24} 
                  color={isEditingInstallment ? colors.textDisabled : colors.staticBlack} 
                />
              </View>
            </Pressable>
          </View>

          {/* 날짜 */}
          <View style={styles.section}>
            <View style={styles.sectionHeader}>
              <Text style={[styles.sectionTitle, { color: colors.staticBlack }]}>
                날짜 <Text style={{ color: '#EF5252' }}>*</Text>
              </Text>
              {isEditingRecurring && originalYearMonth && (
                <Text style={[styles.currentYearMonth, { color: colors.textAssistive }]}>
                  최초 생성년월 : {originalYearMonth}
                </Text>
              )}
              {isEditingInstallment && installmentPeriod && (
                <Text style={[styles.currentYearMonth, { color: colors.textAssistive }]}>
                  최초 생성년월 : {(() => {
                    const [startPeriod] = installmentPeriod.split(' - ');
                    return `20${startPeriod}`;
                  })()}
                </Text>
              )}
            </View>
            {isEditingRecurring ? (
              <Pressable 
                onPress={() => {
                  if (isEditingInstallment) {
                    setToastMessage('변경할 수 없습니다. 새로 생성해 주세요.');
                    setShowToast(true);
                    return;
                  }
                  Keyboard.dismiss();
                  setShowDayPicker(true);
                }}
              >
                <View style={[
                  styles.dayPickerInput, 
                  { 
                    backgroundColor: isEditingInstallment ? colors.fillDisabled : colors.staticWhite, 
                    borderColor: colors.border 
                  }
                ]}>
                  <Text style={[styles.dayPickerLabel, { color: isEditingInstallment ? colors.textDisabled : colors.text }]}>
                    생성일 기준 매달
                  </Text>
                  <View style={styles.dayPickerRight}>
                    <Text style={[styles.dayPickerValue, { color: isEditingInstallment ? colors.textDisabled : colors.textAssistive }]}>
                      {(() => {
                        const [year, month, day] = date.split('.').map(d => parseInt(d, 10));
                        const dayOfWeek = getDayOfWeekLabel(year, month, selectedDay);
                        return `${selectedDay}일(${dayOfWeek})`;
                      })()}
                    </Text>
                    <Icon 
                      name="arrowRight" 
                      variant="line" 
                      size={24} 
                      color={isEditingInstallment ? colors.textDisabled : colors.staticBlack} 
                    />
                  </View>
                </View>
              </Pressable>
            ) : (
              <Input
                variant="line"
                icon="calendarMonth"
                value={(() => {
                  if (!date) return '';
                  const [year, month, day] = date.split('.').map(d => parseInt(d, 10));
                  const dayOfWeek = getDayOfWeekLabel(year, month, day);
                  return `${date}(${dayOfWeek})`;
                })()}
                editable={false}
                placeholder="날짜 선택"
                onPress={handleDatePress}
              />
            )}
          </View>

          {/* 소비 금액 */}
          <View style={styles.section}>
            <Text style={[styles.sectionTitle, { color: colors.staticBlack }]}>
              소비 금액 <Text style={{ color: '#EF5252' }}>*</Text>
            </Text>
            {isInstallment ? (
              <View style={styles.amountWithInstallment}>
                {/* 할부 개월 수 드롭다운 */}
                <Pressable
                  style={[styles.installmentDropdown, { borderColor: colors.border, backgroundColor: colors.staticWhite }]}
                  onPress={handleInstallmentPickerOpen}
                >
                  <Text style={[styles.dropdownText, { color: colors.text }]}>
                    {installmentMonths}개월
                  </Text>
                  <Icon name="arrowUp" variant="line" size={24} color={colors.textAssistive} />
                </Pressable>

                {/* 금액 Input */}
                <View style={styles.amountInput}>
                  <Input
                    variant="line"
                    inputType="number"
                    unit="원"
                    value={amount}
                    onChangeText={setAmount}
                    keyboardType="numeric"
                    placeholder="0"
                    textAlign="right"
                  />
                </View>
              </View>
            ) : (
              <Input
                variant="line"
                inputType="number"
                unit="원"
                value={amount}
                onChangeText={setAmount}
                keyboardType="numeric"
                placeholder="0"
                textAlign="right"
              />
            )}
          </View>

          {/* 소비 형태 */}
          <View style={styles.section}>
            <Text style={[styles.sectionTitle, { color: colors.staticBlack }]}>
              소비 형태
            </Text>
            <View style={[styles.card, { backgroundColor: colors.staticWhite }]}>
              {/* 정기 지출 여부 */}
              <View style={styles.switchRow}>
                <View style={styles.switchInfo}>
                  <Text style={[styles.switchLabel, { color: colors.text }]}>
                    정기 지출 여부
                  </Text>
                  <Text style={[styles.switchDescription, { color: colors.textAssistive }]}>
                    {isEditingRecurring
                      ? '정기 지출 기록은 옵션을 해제할 수 없습니다.'
                      : isEditingInstallment
                      ? '할부 기록이므로 사용할 수 없습니다.'
                      : '매달마다 자동으로 지출을 기록합니다.'
                    }
                  </Text>
                </View>
                <Pressable
                  onPress={() => {
                    if (isEditingRecurring) {
                      console.log('🚫 [제한] 정기 지출 기록은 옵션 해제 불가 → Toast 표시');
                      setToastMessage('정기 지출로 생성된 내역은 해제할 수 없습니다.');
                      setShowToast(true);
                    } else if (isEditingInstallment) {
                      console.log('🚫 [제한] 할부 기록은 정기 지출 옵션 사용 불가 → Toast 표시');
                      setToastMessage('할부 기록이므로 사용할 수 없습니다.');
                      setShowToast(true);
                    }
                  }}
                >
                  <Switch
                    value={isRecurring}
                    disabled={isEditingRecurring}
                    onValueChange={(value) => {
                      if (!isEditingRecurring) {
                        setIsRecurring(value);
                      }
                    }}
                  />
                </Pressable>
              </View>

              {/* Divider */}
              <View style={[styles.divider, { backgroundColor: colors.border }]} />

              {/* 할부 여부 */}
              <View style={styles.switchRow}>
                <View style={styles.switchInfo}>
                  <Text style={[styles.switchLabel, { color: colors.text }]}>
                    할부 여부
                  </Text>
                  <Text style={[styles.switchDescription, { color: colors.textAssistive }]}>
                    {isEditingRecurring
                      ? '정기 지출 기록은 옵션을 해제할 수 없습니다.'
                      : isEditingInstallment
                      ? '할부를 해제할 수 없습니다. 새로 생성해 주세요.'
                      : '할부 기간동안 해당 소비금액을 자동 기록합니다.'
                    }
                  </Text>
                </View>
                <Pressable
                  onPress={() => {
                    if (isEditingRecurring) {
                      console.log('🚫 [제한] 정기 지출 기록은 할부 옵션 변경 불가 → Toast 표시');
                      setToastMessage('정기 기록이므로 할부 적용은 할 수 없습니다.');
                      setShowToast(true);
                    } else if (isEditingInstallment) {
                      // 할부 기록의 경우, 금월 선납 기록만 수정 가능
                      const currentYearMonth = new Date().toISOString().slice(0, 7); // YYYY-MM
                      const recordYearMonth = recordData.date.slice(0, 7).replace('.', '-'); // YYYY-MM
                      const isCurrentMonth = recordYearMonth === currentYearMonth;
                      const isPrepaidRecord = recordData.isPrepaid;
                      
                      if (isCurrentMonth && isPrepaidRecord) {
                        // 금월 선납 기록은 수정 가능
                        console.log('✅ [제한] 금월 선납 기록 - 할부 옵션 변경 가능');
                        // 체크박스 상태 변경 로직 실행
                      } else {
                        console.log('🚫 [제한] 할부 기록은 할부 옵션 해제 불가 → Toast 표시');
                        setToastMessage('할부를 해제할 수 없습니다. 새로 생성해 주세요.');
                        setShowToast(true);
                      }
                    }
                  }}
                >
                  <Switch
                    value={isInstallment}
                    disabled={isEditingInstallment && !(recordData.isPrepaid && recordData.date.slice(0, 7).replace('.', '-') === new Date().toISOString().slice(0, 7))}
                    onValueChange={(value) => {
                      if (!isEditingInstallment) {
                        setIsInstallment(value);
                      }
                    }}
                  />
                </Pressable>
              </View>
            </View>
          </View>

          {/* 기록일이 주말인 경우 (정기 지출 기록이면 항상 표시) */}
          {isRecurring && (
            <View style={styles.section}>
              <Text style={[styles.sectionTitle, { color: colors.staticBlack }]}>
                기록일이 주말인 경우
              </Text>
              <View style={[styles.card, { backgroundColor: colors.staticWhite }]}>
                {/* 관계없이 주말 기록 */}
                <Pressable 
                  onPress={() => {
                    if (isEditingInstallment) {
                      setToastMessage('변경할 수 없습니다. 새로 생성해 주세요.');
                      setShowToast(true);
                    } else {
                      setWeekendOption('weekend');
                    }
                  }}
                >
                  <View style={styles.radioRow}>
                    <Radio
                      checked={weekendOption === 'weekend'}
                      disabled={isEditingInstallment}
                      label="관계없이 주말 기록"
                    />
                  </View>
                </Pressable>

                {/* Divider */}
                <View style={[styles.divider, { backgroundColor: colors.border }]} />

                {/* 금주 금요일 기록 */}
                <Pressable 
                  onPress={() => {
                    if (isEditingInstallment) {
                      setToastMessage('변경할 수 없습니다. 새로 생성해 주세요.');
                      setShowToast(true);
                    } else {
                      setWeekendOption('friday');
                    }
                  }}
                >
                  <View style={styles.radioRow}>
                    <Radio
                      checked={weekendOption === 'friday'}
                      disabled={isEditingInstallment}
                      label="금주 금요일 기록"
                    />
                  </View>
                </Pressable>

                {/* Divider */}
                <View style={[styles.divider, { backgroundColor: colors.border }]} />

                {/* 차주 월요일 기록 */}
                <Pressable 
                  onPress={() => {
                    if (isEditingInstallment) {
                      setToastMessage('변경할 수 없습니다. 새로 생성해 주세요.');
                      setShowToast(true);
                    } else {
                      setWeekendOption('monday');
                    }
                  }}
                >
                  <View style={styles.radioRow}>
                    <Radio
                      checked={weekendOption === 'monday'}
                      disabled={isEditingInstallment}
                      label="차주 월요일 기록"
                    />
                  </View>
                </Pressable>
              </View>
            </View>
          )}

          {/* 메모 */}
          <View 
            style={styles.section}
            onLayout={(event) => {
              const layout = event.nativeEvent.layout;
              setMemoSectionY(layout.y);
            }}
          >
            <Text style={[styles.sectionTitle, { color: colors.staticBlack }]}>
              메모
            </Text>
            <Input
              variant="area"
              value={memo}
              onChangeText={setMemo}
              placeholder="메모를 입력해 주세요.(최대 20자)"
              maxLength={20}
              multiline
              onFocus={handleMemoFocus}
            />
          </View>
        </ScrollView>
      </View>

      {/* 하단 고정 영역: 기간 선택 + 확인 버튼 */}
      <View style={[
        styles.bottomFixedContainer,
        {
          backgroundColor: colors.staticWhite,
          paddingBottom: 16 + insets.bottom
        }
      ]}>
        {/* 정기 지출 기록: 전체 수정 / 오늘만 수정 */}
        {(isEditingRecurring || isEditingAutoGenerated) && originalYearMonth && (
          <View style={[styles.periodSelectContainer, { backgroundColor: colors.fill }]}>
            <Text style={[styles.periodText, { color: colors.text }]}>
              기간 : {(() => {
                const [yearStr, monthStr] = originalYearMonth.split('/');
                const year = parseInt(yearStr, 10);
                const month = parseInt(monthStr, 10);
                const yearShort = year.toString().slice(-2);
                const endYear = year + 1;
                const endYearShort = endYear.toString().slice(-2);
                return `${yearShort}/${String(month).padStart(2, '0')} - ${endYearShort}/${String(month).padStart(2, '0')}`;
              })()}
            </Text>
            <View style={styles.periodRadioGroup}>
              <Radio
                checked={!editOnlyThis}
                onPress={() => setEditOnlyThis(false)}
                label="전체 수정"
              />
              <Radio
                checked={editOnlyThis}
                onPress={() => setEditOnlyThis(true)}
                label="오늘만 수정"
              />
            </View>
          </View>
        )}

        {/* 할부 기록: 선납 처리 */}
        {isEditingInstallment && installmentPeriod && (() => {
          // 선납 처리 가능 여부 판단
          const currentDate = new Date();
          const currentYearMonth = `${currentDate.getFullYear()}-${String(currentDate.getMonth() + 1).padStart(2, '0')}`;
          
          // 할부 기록의 날짜에서 년-월 추출 (YYYY.MM.DD 형식에서 YYYY-MM 형식으로 변환)
          const recordYearMonth = recordData.date.replace(/\./g, '-').slice(0, 7);
          
          // 선납 처리 가능 여부:
          // 1. 미래 기록: 선납 가능
          // 2. 금월 + 선납된 기록: 복원 가능
          // 3. 이전 월 또는 금월 일반 할부: 불가능
          const canPrepay = 
            recordYearMonth > currentYearMonth ||  // 미래 기록
            (recordYearMonth === currentYearMonth && !recordData.isPrepaid); // 금월 + 아직 선납 안된 기록
          
          // 디버깅 로그
          console.log('🔍 [선납처리] 날짜 비교:', {
            currentYearMonth,
            recordYearMonth,
            recordDataDate: recordData.date,
            canPrepay,
            isPrepaidChecked
          });
          
          return (
            <View style={[styles.periodSelectContainer, { backgroundColor: colors.fill }]}>
              <Text style={[styles.periodText, { color: colors.text }]}>
                기간 : {installmentPeriod}
              </Text>
              <Checkbox
                checked={isPrepaidChecked}
                onPress={() => {
                  console.log('🔘 [선납처리] 체크박스 클릭:', { canPrepay, isPrepaidChecked });
                  
                  if (!canPrepay) {
                    // 선납 처리 불가능한 경우 토스트 표시
                    console.log('🚫 [선납처리] 토스트 표시 시도');
                    
                    // 금월 선납 기록은 되돌리기 가능
                    const currentYearMonth = new Date().toISOString().slice(0, 7);
                    const recordYearMonth = recordData.date.slice(0, 7).replace('.', '-');
                    const isCurrentMonth = recordYearMonth === currentYearMonth;
                    const isPrepaidRecord = recordData.isPrepaid;
                    
                    if (isCurrentMonth && isPrepaidRecord) {
                      // 금월 선납 기록은 되돌리기 가능
                      console.log('✅ [선납처리] 금월 선납 기록 - 되돌리기 가능');
                      setIsPrepaidChecked(!isPrepaidChecked);
                    } else {
                      setToastMessage('금월 포함 이전날짜 기록은 선납 처리 불가합니다.');
                      setShowToast(true);
                    }
                    return;
                  }
                  
                  console.log('✅ [선납처리] 선납 처리 가능 - 상태 변경');
                  setIsPrepaidChecked(!isPrepaidChecked);
                }}
                label="이번달 선납 처리"
                disabled={!canPrepay && !(recordData.isPrepaid && recordData.date.slice(0, 7).replace('.', '-') === new Date().toISOString().slice(0, 7))}
              />
            </View>
          );
        })()}

        {/* 확인 버튼 */}
        <View style={styles.bottomButtonContainer}>
          <Button onPress={() => {
            console.log('🔘 [버튼] 확인 버튼 onPress 호출됨');
            handleConfirm();
          }}>
            확인
          </Button>
        </View>
      </View>

      {/* 할부 개월 수 선택 Picker 모달 */}
      <Modal
        visible={showInstallmentPicker}
        transparent
        animationType="fade"
        onRequestClose={() => setShowInstallmentPicker(false)}
      >
        <View style={styles.pickerModalOverlay}>
          <Pressable 
            style={styles.pickerModalBackdrop}
            onPress={() => setShowInstallmentPicker(false)}
          />
          <View style={[styles.pickerModalContainer, { backgroundColor: colors.background }]}>
            <View style={[styles.pickerHeader, { backgroundColor: colors.background }]}>
              <Pressable onPress={() => setShowInstallmentPicker(false)} style={styles.headerButton}>
                <Text style={[styles.cancelButton, { color: colors.textNeutral }]}>
                  취소
                </Text>
              </Pressable>
              
              <Text style={[styles.pickerTitle, { color: colors.text }]}>
                할부 개월 수
              </Text>
              
              <Pressable onPress={() => setShowInstallmentPicker(false)} style={styles.headerButton}>
                <Text style={[styles.doneButton, { color: colors.primary }]}>
                  완료
                </Text>
              </Pressable>
            </View>
            
            <View style={styles.pickerRow}>
              <Picker
                selectedValue={installmentMonths}
                onValueChange={(value) => setInstallmentMonths(value)}
                style={[styles.picker, { backgroundColor: colors.staticWhite }]}
              >
                {Array.from({ length: 11 }, (_, i) => i + 2).map((month) => (
                  <Picker.Item
                    key={month}
                    label={`${month}개월`}
                    value={month}
                  />
                ))}
              </Picker>
            </View>
          </View>
        </View>
      </Modal>

      {/* 날짜 선택 바텀시트 */}
      {showDatePicker && (
        <ModalBottomsheet
          visible={true}
          title="소비 기록일 선택"
          onClose={handleDatePickerClose}
          closeOnBackdrop={true}
          contentStyle={styles.dateBottomsheetContent}
        >
        <CalendarDaySelect
          selectedDate={tempSelectedDate}
          onDayPress={(dateString) => {
            setTempSelectedDate(dateString);
          }}
        />
          
          <View style={styles.dateButtonArea}>
            <Pressable
              style={[styles.dateButton, { backgroundColor: colors.primary }]}
              onPress={handleDateConfirm}
            >
              <Text style={[styles.dateButtonText, { color: colors.staticWhite }]}>
                확인
              </Text>
            </Pressable>
          </View>
        </ModalBottomsheet>
      )}

      {/* 일자 선택 Picker 모달 */}
      <Modal
        visible={showDayPicker}
        transparent
        animationType="fade"
        onRequestClose={() => setShowDayPicker(false)}
      >
        <View style={styles.pickerModalOverlay}>
          <Pressable 
            style={styles.pickerModalBackdrop}
            onPress={() => setShowDayPicker(false)}
          />
          <View style={[styles.pickerModalContainer, { backgroundColor: colors.background }]}>
            <View style={[styles.pickerHeader, { backgroundColor: colors.background }]}>
              <Pressable onPress={() => setShowDayPicker(false)} style={styles.headerButton}>
                <Text style={[styles.cancelButton, { color: colors.textNeutral }]}>
                  취소
                </Text>
              </Pressable>
              
              <Text style={[styles.pickerTitle, { color: colors.text }]}>
                일자 선택
              </Text>
              
              <Pressable onPress={() => {
                // 선택한 일자로 날짜 업데이트 (연/월 유지)
                const [year, month] = date.split('.');
                const actualDay = getActualDayForMonth(parseInt(year), parseInt(month), selectedDay);
                const newDate = `${year}.${month}.${String(actualDay).padStart(2, '0')}`;
                setDate(newDate);
                setShowDayPicker(false);
              }} style={styles.headerButton}>
                <Text style={[styles.doneButton, { color: colors.primary }]}>
                  완료
                </Text>
              </Pressable>
            </View>
            
            <View style={styles.pickerRow}>
              <Picker
                selectedValue={selectedDay}
                onValueChange={(value) => setSelectedDay(value)}
                style={styles.picker}
                itemStyle={styles.pickerItem}
              >
                {Array.from({ length: 31 }, (_, i) => i + 1).map(day => {
                  const [year, month] = date.split('.').map(d => parseInt(d, 10));
                  const dayOfWeek = getDayOfWeekLabel(year, month, day);
                  return (
                    <Picker.Item key={day} label={`${day}일(${dayOfWeek})`} value={day} />
                  );
                })}
              </Picker>
            </View>
          </View>
        </View>
      </Modal>

      {/* 카테고리 미선택 얼럿 */}
      <ModalPopup
        visible={showCategoryAlert}
        onConfirm={() => setShowCategoryAlert(false)}
        confirmText="확인"
      >
        <Text style={[styles.alertText, { color: colors.text }]}>
          카테고리를 선택해 주세요.
        </Text>
      </ModalPopup>

      {/* 금액 미입력 얼럿 */}
      <ModalPopup
        visible={showAmountAlert}
        onConfirm={() => setShowAmountAlert(false)}
        confirmText="확인"
      >
        <Text style={[styles.alertText, { color: colors.text }]}>
          금액을 입력해 주세요.
        </Text>
      </ModalPopup>

      {/* 삭제 확인 얼럿 */}
      <ModalPopup
        visible={showDeleteAlert}
        title={isEditingInstallment ? "할부 지출 기록 안내" : undefined}
        onConfirm={handleDelete}
        confirmText="삭제"
        cancelText="취소"
        onCancel={() => setShowDeleteAlert(false)}
      >
        <Text style={[styles.alertText, { color: colors.text }]}>
          {isEditingInstallment
            ? '설정한 기간동안 기록된 할부 지출\n기록 내역이 모두 삭제 됩니다.'
            : '정말로 이 소비내역을 삭제하시겠습니까?'
          }
        </Text>
      </ModalPopup>

      {/* 변경사항 없음 얼럿 */}
      <ModalPopup
        visible={showNoChangesAlert}
        onConfirm={() => setShowNoChangesAlert(false)}
        confirmText="확인"
      >
        <Text style={[styles.alertText, { color: colors.text }]}>
          변경된 내용이 없습니다.
        </Text>
      </ModalPopup>

      {/* 정기 지출 주말 확인 모달 */}
      <ModalPopup
        visible={showWeekendConfirm}
        title="정기 기록 주말여부 안내"
        onConfirm={async () => {
          setShowWeekendConfirm(false);
          await saveExpenseEdit();
        }}
        onCancel={() => setShowWeekendConfirm(false)}
        confirmText="확인"
        cancelText="취소"
      >
        <Text style={[styles.weekendConfirmText, { color: colors.textNeutral }]}>
          지정하신 날짜가 주말에 해당 됩니다.{'\n'}
          선택하신 옵션에 따라{'\n'}
          '{weekendOption === 'friday' ? '금주 금요일 기록' : weekendOption === 'monday' ? '차주 월요일 기록' : '관계없이 주말 기록'}'에 기록됩니다.{'\n'}
          진행하시겠어요?
        </Text>
      </ModalPopup>

      {/* 정기 지출 기록 수정 확인 모달 */}
      <ModalPopup
        visible={showRecurringEditConfirm}
        title="정기 지출 기록 안내"
        onConfirm={async () => {
          setShowRecurringEditConfirm(false);
          await saveExpenseEdit();
        }}
        onCancel={() => setShowRecurringEditConfirm(false)}
        confirmText="확인"
        cancelText="취소"
      >
        <Text style={[styles.weekendConfirmText, { color: colors.textNeutral }]}>
          {editOnlyThis 
            ? '매달 마다 자동으로 기록되는\n데이터 중 오늘 데이터만 수정하시겠어요?'
            : '매달 마다 자동으로 기록되는\n데이터 모두를 수정하시겠어요?'
          }
        </Text>
      </ModalPopup>

      {/* 할부 기록 수정 확인 모달 */}
      <ModalPopup
        visible={showInstallmentConfirm}
        title="할부 지출 기록 안내"
        onConfirm={async () => {
          setShowInstallmentConfirm(false);
          await saveExpenseEdit();
        }}
        onCancel={() => setShowInstallmentConfirm(false)}
        confirmText="확인"
        cancelText="취소"
      >
        <Text style={[styles.weekendConfirmText, { color: colors.textNeutral }]}>
          설정하신 내역대로{'\n'}
          이번달 할부 기록은 선납 기록으로 수정되며{'\n'}
          {new Date().getFullYear()}년 {String(new Date().getMonth() + 1).padStart(2, '0')}월 {String(new Date().getDate()).padStart(2, '0')}일에 선납이 기록됩니다.
        </Text>
      </ModalPopup>

      {/* 선납 기록 되돌리기 확인 모달 */}
      <ModalPopup
        visible={showPrepaidRevertConfirm}
        title="할부 지출 기록 안내"
        onConfirm={async () => {
          setShowPrepaidRevertConfirm(false);
          await revertPrepaidRecord();
        }}
        onCancel={() => setShowPrepaidRevertConfirm(false)}
        confirmText="확인"
        cancelText="취소"
      >
        <Text style={[styles.weekendConfirmText, { color: colors.textNeutral }]}>
          선납부 기록 취소 시{'\n'}
          최초 기록 내역대로 수정되며{'\n'}
          {originalInstallmentDateForModal || '원래 날짜'}에 할부가 기록됩니다.
        </Text>
      </ModalPopup>

      {/* Toast */}
      <Toast
        message={toastMessage}
        visible={showToast}
        onHide={() => setShowToast(false)}
      />
    </SafeAreaView>
  );
}

