# =============================================================================
# Amplitude (`utils/analytics.ts` — 변수 이름 그대로 사용)
# =============================================================================
# 로컬에서 쓰는 파일 (gitignore — 커밋 금지):
#   `.env`              → `npm start` 및 아래 스크립트의 **공통 기본**
#   `.env.ing.local`    → `npm run start:ing` 전용 덮어쓰기 (없으면 start:ing 실패)
#   `.env.production.local` → `npm run start:prod` 전용 덮어쓰기 (없으면 start:prod 실패)
#
# 로드 순서:
#   - `npm start`           → `.env` 만
#   - `npm run start:ing`   → `.env` 후 `.env.ing.local`
#   - `npm run start:prod`  → `.env` 후 `.env.production.local`
#
# 예시 복사:
#   cp .env.example .env
#   cp .env.ing.local.example .env.ing.local
#   cp .env.production.local.example .env.production.local
#
# EAS 클라우드 빌드 / OTA: expo.dev → 프로젝트 → Environment variables
#   - production  → 스토어용 PROD 키
#   - preview     → 스테이지·stage 채널용 DEBUG 키
#   - development → 개발 클라이언트
# `eas.json` build 프로필이 위 환경 이름과 연결되어 있음.
#
# legacy 키는 production EAS 환경에 두지 않는 것이 안전함 (PROD 비면 legacy로 넘어감).
# =============================================================================

EXPO_PUBLIC_AMPLITUDE_API_KEY_DEBUG=
EXPO_PUBLIC_AMPLITUDE_API_KEY_PROD=
# EXPO_PUBLIC_AMPLITUDE_API_KEY=
