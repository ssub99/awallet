{
  "cli": {
    "version": ">= 5.9.0"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "stage": {
      "distribution": "internal",
      "channel": "stage",
      "ios": {
        "buildConfiguration": "Release",
        "buildNumber": "10"
      },
      "android": {
        "versionCode": 10
      }
    },
    "stage-testflight": {
      "distribution": "store",
      "channel": "stage",
      "ios": {
        "buildConfiguration": "Release",
        "buildNumber": "10"
      },
      "android": {
        "versionCode": 10
      }
    },
    "production": {
      "distribution": "store",
      "channel": "production",
      "ios": {
        "buildConfiguration": "Release"
      }
    }
  },
  "submit": {
    "stage": {},
    "production": {}
  }
}