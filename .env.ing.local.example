# npm run start:ing 전에 `.env.ing.local` 로 복사해 사용하세요.
#
# API 베이스: start-ing.sh 가 비어 있으면 자동으로 ing Vercel Preview URL을 씁니다.
# 다른 배포(다른 Preview URL)를 쓰려면 아래를 명시하세요.
# EXPO_PUBLIC_AWALLET_API_BASE_URL=https://awallet-git-ing-awallet-vercel-api.vercel.app

# consumption-report / parse-expense 호출에 필요 (Vercel AWALLET_INTERNAL_API_SECRET 과 동일 값)
EXPO_PUBLIC_AWALLET_INTERNAL_API_SECRET=
