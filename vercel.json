{
  "version": 2,
  "framework": null,
  "buildCommand": "mkdir -p public && echo '<!DOCTYPE html><html><body><p>API only.</p></body></html>' > public/index.html",
  "builds": [
    {
      "src": "api/consumption-report.ts",
