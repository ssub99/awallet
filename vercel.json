{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "framework": null,
  "buildCommand": "test -f public/index.html && test -f api/consumption-report.ts && test -f api/parse-expense.ts",
  "outputDirectory": "public",
  "functions": {
    "api/parse-expense.ts": {
      "memory": 256,
      "maxDuration": 30
    },
    "api/consumption-report.ts": {
      "memory": 256,
      "maxDuration": 30
    }
  }
}
