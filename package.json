{
  "name": "awallet",
  "main": "index.js",
  "version": "1.2.4",
  "scripts": {
    "start": "expo start",
    "start:ing": "bash ./scripts/start-with-env.sh",
    "start:prod": "bash ./scripts/start-with-env.sh",
    "dev:notices-sync": "bash ./scripts/run-dev-notices-sync.sh",
    "migrate:dev-notices": "node scripts/migrate-dev-notices-to-static.mjs",
    "reset-project": "node ./scripts/reset-project.js",
    "regenerate-android-splash": "node ./scripts/regenerate-android-splash.mjs",
    "android": "expo run:android",
    "android:stage": "EAS_BUILD_PROFILE=stage expo run:android --variant stageDebug --app-id com.ssong.awallet.stage",
    "android:production": "EAS_BUILD_PROFILE=production expo run:android --variant productionDebug --app-id com.ssong.awallet",
    "android:install-production-release": "cd android && ./gradlew :app:installProductionRelease",
    "android:release-bundle": "cd android && ./gradlew :app:bundleProductionRelease",
    "android:setup-signing": "bash scripts/setup-android-release-signing.sh",
    "ios": "expo run:ios --scheme awallet-stage",
    "ios:stage": "EAS_BUILD_PROFILE=stage expo run:ios --scheme awallet-stage",
    "ios:production": "EAS_BUILD_PROFILE=production expo run:ios --scheme awallet-production",
    "web": "expo start --web",
    "lint": "expo lint",
    "verify:memo": "npx tsx scripts/verify-parse-expense-memo.ts",
    "verify:simple": "npx tsx scripts/verify-parse-expense-simple.ts",
    "verify:slots": "npx tsx scripts/verify-parse-expense-slots.ts",
    "verify:won": "npx tsx scripts/verify-parse-korean-won-amount.ts",
    "try:parse": "npx tsx scripts/try-parse-expense.ts",
    "verify:reviews": "npx tsx scripts/verify-parse-expense-reviews.ts",
    "verify:recurring-month": "npx tsx scripts/verify-recurring-month-anchor.ts",
    "verify:record-inbox-stack": "npx tsx scripts/verify-record-inbox-stack-frame.ts",
    "verify:record-inbox-parse": "npx tsx scripts/verify-record-inbox-parse.ts",
    "eas": "eas",
    "postinstall": "bash scripts/postinstall.sh"
  },
  "dependencies": {
    "@amplitude/analytics-react-native": "^1.7.0",
