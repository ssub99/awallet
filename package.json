{
  "name": "awallet",
  "main": "expo-router/entry",
  "version": "1.1.7",
  "scripts": {
    "start": "expo start",
    "start:ing": "bash ./scripts/start-with-env.sh",
    "start:prod": "bash ./scripts/start-with-env.sh",
    "dev:notices-sync": "node scripts/dev-notices-sync-server.mjs",
    "migrate:dev-notices": "node scripts/migrate-dev-notices-to-static.mjs",
    "reset-project": "node ./scripts/reset-project.js",
    "regenerate-android-splash": "node ./scripts/regenerate-android-splash.mjs",
    "android": "expo run:android",
    "android:stage": "EAS_BUILD_PROFILE=stage expo run:android --variant stageDebug --app-id com.ssong.awallet.stage",
    "android:production": "EAS_BUILD_PROFILE=production expo run:android --variant productionDebug --app-id com.ssong.awallet",
    "android:install-production-release": "cd android && ./gradlew :app:installProductionRelease",
    "android:release-bundle": "cd android && ./gradlew :app:bundleProductionRelease",
    "android:setup-signing": "bash scripts/setup-android-release-signing.sh",
    "ios": "expo run:ios --scheme awallet-stage",
    "ios:stage": "EAS_BUILD_PROFILE=stage expo run:ios --scheme awallet-stage",
    "ios:production": "EAS_BUILD_PROFILE=production expo run:ios --scheme awallet-production",
    "web": "expo start --web",
    "lint": "expo lint",
    "verify:memo": "npx tsx scripts/verify-parse-expense-memo.ts",
    "verify:simple": "npx tsx scripts/verify-parse-expense-simple.ts",
    "verify:slots": "npx tsx scripts/verify-parse-expense-slots.ts",
    "verify:won": "npx tsx scripts/verify-parse-korean-won-amount.ts",
    "try:parse": "npx tsx scripts/try-parse-expense.ts",
    "verify:reviews": "npx tsx scripts/verify-parse-expense-reviews.ts",
    "verify:recurring-month": "npx tsx scripts/verify-recurring-month-anchor.ts",
    "eas": "eas",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@amplitude/analytics-react-native": "^1.5.52",
    "@amplitude/plugin-session-replay-react-native": "^0.4.10",
    "@expo/ngrok": "^4.1.3",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-community/datetimepicker": "8.4.4",
    "@react-native-firebase/analytics": "^23.5.0",
    "@react-native-firebase/app": "^23.5.0",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.4.0",
    "@react-navigation/elements": "^2.6.3",
    "@react-navigation/native": "^7.1.8",
    "@react-navigation/stack": "^7.9.2",
    "@shopify/flash-list": "2.0.2",
    "expo": "~54.0.33",
    "expo-blur": "^15.0.8",
    "expo-constants": "~18.0.13",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.21",
    "expo-font": "~14.0.9",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.11",
    "expo-mail-composer": "~15.0.8",
    "expo-notifications": "~0.32.16",
    "expo-router": "~6.0.23",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-tracking-transparency": "~6.0.8",
    "expo-updates": "~29.0.16",
    "expo-video": "~3.0.16",
    "expo-video-thumbnails": "~10.0.8",
    "expo-web-browser": "~15.0.10",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-calendars": "^1.1313.0",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-fbsdk-next": "^13.4.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-get-random-values": "~2.0.0",
    "react-native-keyboard-controller": "1.18.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "5.6.1",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "reanimated-color-picker": "^4.2.0",
    "ulid": "^3.0.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-js-style": "^1.2.0"
  },
  "overrides": {
    "react-native-safe-area-context": "5.6.1",
    "postcss": "^8.5.14",
    "tar": "^7.5.15",
    "node-forge": "^1.4.0",
    "@xmldom/xmldom": "^0.9.10",
    "minimatch": "^10.2.5",
    "yaml": "^2.8.3",
    "ajv": "^8.18.0",
    "diff": "^8.0.3",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "~19.1.0",
    "@types/react-native-calendars": "^1.1264.7",
    "eas-cli": "^18.13.1",
    "eslint": "^9.25.0",
    "eslint-config-expo": "~10.0.0",
    "patch-package": "^8.0.1",
    "react-native-svg-transformer": "^1.5.1",
    "typescript": "~5.9.2"
  },
  "private": true
}
