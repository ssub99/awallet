{
  "expo": {
    "name": "awallet",
    "slug": "awallet",
    "version": "1.2.0",
    "description": "당신의 현명한 소비 기록 awallet",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "awallet",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "ios": {
      "deploymentTarget": "17.0",
      "supportsTablet": true,
      "bundleIdentifier": "com.ssong.awallet",
      "appStoreUrl": "https://apps.apple.com/kr/app/id6755246069",
      "buildNumber": "50",
      "userInterfaceStyle": "light",
      "googleServicesFile": "./ios/awallet/GoogleService-Info.plist",
      "infoPlist": {
        "CFBundleDisplayName": "에이월렛",
        "CFBundleName": "에이월렛",
        "NSUserNotificationsUsageDescription": "소비 기록 알림과 챌린지 리마인더를 받기 위해 알림 권한이 필요합니다.",
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleShortVersionString": "1.2.0",
        "CFBundleVersion": "50",
        "UIViewControllerBasedStatusBarAppearance": true
      },
      "runtimeVersion": "1.2.0"
    },
    "android": {
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png"
      },
      "userInterfaceStyle": "light",
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ssong.awallet",
      "googleServicesFile": "./android-firebase/google-services.json",
      "playStoreUrl": "https://play.google.com/store/apps/details?id=com.ssong.awallet",
      "versionCode": 50,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "runtimeVersion": "1.2.0"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      "expo-video",
      [
        "expo-splash-screen",
        {
          "ios": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 96,
            "resizeMode": "contain",
            "backgroundColor": "#ffffff",
            "dark": {
              "backgroundColor": "#ffffff"
            }
          },
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 100,
            "resizeMode": "contain",
            "backgroundColor": "#ffffff",
            "dark": {
              "backgroundColor": "#ffffff"
            }
          }
        }
      ],
      [
        "expo-font",
        {
          "fonts": [
            "./assets/fonts/Pretendard-Regular.otf",
            "./assets/fonts/Pretendard-Medium.otf",
            "./assets/fonts/Pretendard-Bold.otf"
          ],
          "android": {
            "fonts": [
              {
                "fontFamily": "Pretendard",
                "fontDefinitions": [
                  {
                    "path": "./assets/fonts/Pretendard-Bold.otf",
                    "weight": 700
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Medium.otf",
                    "weight": 500
                  },
                  {
                    "path": "./assets/fonts/Pretendard-Regular.otf",
                    "weight": 400
                  }
                ]
              }
            ]
          },
          "ios": {
            "fonts": [
              "./assets/fonts/Pretendard-Regular.otf",
              "./assets/fonts/Pretendard-Medium.otf",
              "./assets/fonts/Pretendard-Bold.otf"
            ]
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#3664CE",
          "sounds": []
        }
      ],
      "@react-native-firebase/app",
      "expo-web-browser",
      "expo-mail-composer",
      [
        "expo-image-picker",
        {
          "photosPermission": "공지사항에 첨부할 사진·영상을 선택하기 위해 사진첩 접근 권한이 필요합니다."
        }
      ],
      "react-native-fbsdk-next",
      "@react-native-community/datetimepicker"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "updates": {
      "url": "https://u.expo.dev/f33074c8-df40-4c61-bcfe-826b22dabd0a",
      "fallbackToCacheTimeout": 0,
      "checkAutomatically": "ON_LOAD",
      "runtimeVersion": "1.2.0"
    },
    "extra": {
      "supportEmail": "ssuby99@gmail.com",
      "privacyPolicyUrl": "https://www.notion.so/2a4b71a1411280069937f6894dd544a6?source=copy_link",
      "appCategory": "finance",
      "router": {},
      "eas": {
        "projectId": "f33074c8-df40-4c61-bcfe-826b22dabd0a"
      }
    }
  }
}
