{
  "expo": {
    "name": "awallet",
    "slug": "awallet",
    "version": "1.0.0",
    "description": "당신의 현명한 소비 기록 awallet",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "awallet",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "privacy": "public",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.ssong.awallet",
      "category": "FINANCE",
      "infoPlist": {
        "NSUserNotificationsUsageDescription": "소비 기록 알림과 챌린지 리마인더를 받기 위해 알림 권한이 필요합니다."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.ssong.awallet",
      "category": "finance",
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "splash": {
      "image": "./assets/images/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff",
      "dark": {
        "image": "./assets/images/splash-icon.png",
        "resizeMode": "contain",
        "backgroundColor": "#ffffff"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#ffffff",
          "dark": {
            "backgroundColor": "#ffffff"
          }
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/images/icon.png",
          "color": "#3664CE",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "SUPABASE_URL": "https://jzyxvkejayspqjdclslr.supabase.co",
      "SUPABASE_ANON_KEY": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6Imp6eXh2a2VqYXlzcHFqZGNsc2xyIiwicm9sZSI6ImFub24iLCJpYXQiOjE3NjAzMjI5OTIsImV4cCI6MjA3NTg5ODk5Mn0.X--IM1XcWfxUqfM-mrpvunhbNVlgWeuWejb2kmhrDsI",
      "supportEmail": "ssuby99@gmail.com",
      "privacyPolicyUrl": "https://www.notion.so/2a4b71a1411280069937f6894dd544a6?source=copy_link",
      "appCategory": "finance"
    }
  }
}
